<Window x:Class="CH_V03.App.Views.EndoscopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内窥镜画面与二维码识别" Width="1180" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#EAF7FF">
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="应用参数并刷新预览" Height="34" Margin="0,16,0,8" Click="ApplyButton_Click" />
                    <Button Content="立即抓图识码" ToolTip="固定当前采集画面，单次识别；仅测试，不触发生产扫码" Height="34" Margin="0,0,0,8" Click="ScanButton_Click" />
                    <Button Content="打开图片识码" Height="34" Margin="0,0,0,8" Click="DecodeImageButton_Click" />
                    <Button Content="保存并启用内窥镜扫码" Height="36" Background="#0284C7" Foreground="White" Click="SaveButton_Click" />
                    <Button Content="取消" Height="34" Margin="0,8,0,0" Click="CancelButton_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="内窥镜参数" FontSize="18" FontWeight="SemiBold" Foreground="#0F4C81" Margin="0,0,0,18" />
                    <TextBlock Text="视频设备" Foreground="#52606D" /><ComboBox x:Name="CameraDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Index" Margin="0,5,0,5" SelectionChanged="CameraDeviceBox_SelectionChanged" />
                    <TextBlock Text="摄像头编号（高级设置）" FontSize="11" Foreground="#64748B" /><TextBox x:Name="CameraIndexBox" Margin="0,4,0,12" Text="0" />
                    <TextBlock Text="画面宽度 × 高度" Foreground="#52606D" />
                    <Grid Margin="0,5,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="WidthBox" Grid.Column="0" /><TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox x:Name="HeightBox" Grid.Column="2" /></Grid>
                    <TextBlock Text="帧率 (FPS)" Foreground="#52606D" /><TextBox x:Name="FrameRateBox" Margin="0,5,0,12" />
                    <TextBlock Text="单次识码等待 (ms)" Foreground="#52606D" /><TextBox x:Name="ScanTimeoutBox" Margin="0,5,0,12" />
                    <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="10"><StackPanel><TextBlock Text="说明" FontWeight="SemiBold" Foreground="#0F4C81" /><TextBlock Text="Supereyes 请以 USB 摄像头接入。打开本页前请关闭原厂 Supereyes 程序，避免设备被占用。" TextWrapping="Wrap" Foreground="#52606D" Margin="0,5,0,0" /></StackPanel></Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Background="#0F172A" CornerRadius="8" Padding="12">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="StatusText" Text="正在连接内窥镜…" Foreground="White" FontWeight="SemiBold" Margin="4,0,4,10" />
                <Grid Grid.Row="1"><Image x:Name="PreviewImage" Stretch="Uniform"/><TextBlock x:Name="PreviewHint" Text="暂无画面" Foreground="#94A3B8" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                <Border Grid.Row="2" Background="#164E63" CornerRadius="5" Padding="10" Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="最近识别：" Foreground="#BAE6FD"/><TextBlock x:Name="LastResultText" Text="—" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
            </Grid>
        </Border>
    </Grid>
</Window>
