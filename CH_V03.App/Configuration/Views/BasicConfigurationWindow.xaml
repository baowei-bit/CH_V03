<Window x:Class="CH_V03.App.Views.BasicConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CH_V03.App.Converters"
        Title="基础配置"
        Width="940"
        Height="620"
        MinWidth="860"
        MinHeight="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#EAF7FF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:ConfigurationFieldVisibilityConverter x:Key="FieldVisibility" />
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="#52606D" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FolderPickerButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="Background" Value="#F0F9FF" />
            <Setter Property="BorderBrush" Value="#7DD3FC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0369A1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FolderPickerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FolderPickerBorder" Property="Background" Value="#E0F2FE" />
                                <Setter TargetName="FolderPickerBorder" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FolderPickerBorder" Property="Background" Value="#BAE6FD" />
                                <Setter TargetName="FolderPickerBorder" Property="BorderBrush" Value="#0EA5E9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter TargetName="FolderPickerBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="FolderPickerBorder" Property="BorderBrush" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#7DD3FC" BorderThickness="1,1,0,0" Padding="14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Command="{Binding SaveCommand}" Width="96" Height="34" Margin="0,0,10,0" />
                <Button Content="退出" Command="{Binding CancelCommand}" Width="96" Height="34" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="当前账号仅可修改保存路径。"
                           Foreground="#0369A1"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"
                           Visibility="{Binding IsOperatorPathOnlyMode, Converter={StaticResource BoolToVisibility}}" />
                <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16"
                        Visibility="{Binding CanManageAllSettings, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="系统设置" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,14,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Identity.CustomerName}">
                                <TextBlock Style="{StaticResource Label}" Text="客户名称" />
                                <TextBox Text="{Binding Configuration.Identity.CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Identity.ProductName}">
                                <TextBlock Style="{StaticResource Label}" Text="产品名称" />
                                <TextBox Text="{Binding Configuration.Identity.ProductName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Identity.TestType}">
                                <TextBlock Style="{StaticResource Label}" Text="测试类型" />
                                <TextBox Text="{Binding Configuration.Identity.TestType, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Identity.TestProgram}">
                                <TextBlock Style="{StaticResource Label}" Text="测试程式" />
                                <TextBox Text="{Binding Configuration.Identity.TestProgram, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Identity.MachineNo}">
                                <TextBlock Style="{StaticResource Label}" Text="机台编号" />
                                <TextBox Text="{Binding Configuration.Identity.MachineNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Identity.BarcodeLength}">
                                <TextBlock Style="{StaticResource Label}" Text="条码长度" />
                                <TextBox Text="{Binding Configuration.Identity.BarcodeLength, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Identity.CodeSuffix}">
                                <TextBlock Style="{StaticResource Label}" Text="条码固定校验码" />
                                <TextBox Text="{Binding Configuration.Identity.CodeSuffix, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Identity.ScanRulePrefix}">
                                <TextBlock Style="{StaticResource Label}" Text="扫码规则前缀" />
                                <TextBox Text="{Binding Configuration.Identity.ScanRulePrefix, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Configuration.Identity.ScanRuleEnabled}" />
                                <CheckBox Content="启用扫码前缀规则"
                                          IsChecked="{Binding Configuration.Identity.ScanRuleEnabled}"
                                          Margin="0,8,0,0"
                                          Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Identity.ScanRuleEnabled}" />
                            </StackPanel>
                            <StackPanel Margin="0" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Output.CsvName}">
                                <TextBlock Style="{StaticResource Label}" Text="CSV 文件前缀" />
                                <TextBox Text="{Binding Configuration.Output.CsvName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <CheckBox Content="启动自动连接扫码枪"
                                      IsChecked="{Binding Configuration.Communication.AutoConnectScannerOnStartup}"
                                      Margin="0,8,14,0"
                                      VerticalAlignment="Center" />
                            <CheckBox Content="启动自动连接下位机"
                                      IsChecked="{Binding Configuration.Communication.AutoConnectLowerMachineOnStartup}"
                                      Margin="0,8,14,0"
                                      VerticalAlignment="Center" />
                            <CheckBox Content="允许连续重复测试"
                                      IsChecked="{Binding Configuration.Identity.AllowContinuousRepeatTest}"
                                      Margin="0,8,14,0"
                                      VerticalAlignment="Center"
                                      ToolTip="未勾选时，与上一笔实际开始测试相同的条码将被阻止；先测试其他条码后可再次测试。" />
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Style="{StaticResource Label}" Text="下位机报文超时（秒）" />
                                <TextBox Text="{Binding Configuration.Communication.LowerMachinePayloadTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Foreground="#94A3B8" FontSize="11" Text="最小 1 秒；未收到 end 或 reset 时作废本次数据" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Content="显示消息弹窗" IsChecked="{Binding Configuration.Popup.Enabled}" Margin="0,8,14,0" VerticalAlignment="Center" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Popup.Enabled}" />
                            <CheckBox Content="弹窗需要确认" IsChecked="{Binding Configuration.Popup.RequireConfirmation}" Margin="0,8,14,0" VerticalAlignment="Center" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Popup.RequireConfirmation}" />
                            <CheckBox Content="消息提醒居中并放大"
                                      IsChecked="{Binding Configuration.Popup.CenterAndEnlarge}"
                                      Margin="0,8,14,0"
                                      VerticalAlignment="Center" />
                            <CheckBox Content="红色提醒"
                                      IsChecked="{Binding Configuration.Popup.RedAlert}"
                                      Margin="0,8,14,0"
                                      VerticalAlignment="Center" />
                        </UniformGrid>

                        <Border BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="扫码规则与限值" />
                                <UniformGrid Columns="3">
                                    <CheckBox Content="启用条码指定位验证"
                                              IsChecked="{Binding Configuration.Identity.BarcodePositionValidationEnabled}"
                                              Margin="0,8,14,12"
                                              VerticalAlignment="Center" />
                                    <StackPanel Margin="0,0,14,12">
                                        <TextBlock Style="{StaticResource Label}" Text="验证位号（从1开始）" />
                                        <TextBox Text="{Binding Configuration.Identity.BarcodeValidationPosition, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource Label}" Text="允许内容" />
                                        <TextBox Text="{Binding Configuration.Identity.BarcodeValidationAllowedValues, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <CheckBox Content="启用条码限值联动"
                                              IsChecked="{Binding Configuration.Identity.BarcodeLimitRuleEnabled}"
                                              Margin="0,8,14,12"
                                              VerticalAlignment="Center" />
                                    <StackPanel Margin="0,0,14,12">
                                        <TextBlock Style="{StaticResource Label}" Text="限值联动测试项序号" />
                                        <TextBox Text="{Binding Configuration.Identity.BarcodeLimitItemIndex, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource Label}" Text="内容到上限映射" />
                                        <TextBox Text="{Binding Configuration.Identity.BarcodeLimitUpperByValue, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Style="{StaticResource Label}" Text="内容到下限映射" />
                                        <TextBox Text="{Binding Configuration.Identity.BarcodeLimitLowerByValue, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="保存路径" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="运行日志路径" Margin="0,0,12,12" VerticalAlignment="Center" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Output.LogDirectory}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Configuration.Output.LogDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Output.LogDirectory}" />
                            <Button Grid.Row="0" Grid.Column="2" Content="浏览" Style="{StaticResource FolderPickerButton}" Click="SelectLogDirectory_Click" Margin="0,0,0,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Output.LogDirectory}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DCL/TXT 保存路径" Margin="0,0,12,12" VerticalAlignment="Center" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Output.DclDirectory}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Configuration.Output.DclDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Output.DclDirectory}" />
                            <Button Grid.Row="1" Grid.Column="2" Content="浏览" Style="{StaticResource FolderPickerButton}" Click="SelectDclDirectory_Click" Margin="0,0,0,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Output.DclDirectory}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="产品 CSV 保存路径" Margin="0,0,12,12" VerticalAlignment="Center" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Output.CsvDirectory}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Configuration.Output.CsvDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Output.CsvDirectory}" />
                            <Button Grid.Row="2" Grid.Column="2" Content="浏览" Style="{StaticResource FolderPickerButton}" Click="SelectCsvDirectory_Click" Margin="0,0,0,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Output.CsvDirectory}" />
                            <CheckBox Grid.Row="3" Grid.Column="1" Content="按测试结果生成 PASS/FAIL 文件夹" IsChecked="{Binding Configuration.Output.ClassifyCsvByResult}" Margin="0,0,0,12" />
                            <CheckBox Grid.Row="4" Grid.Column="1" Content="启用扫码客户路径保存" IsChecked="{Binding Configuration.Output.CustomerPathSaveEnabled}" Margin="0,0,0,12" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="客户路径保存根目录" Margin="0,0,12,12" VerticalAlignment="Center" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Configuration.Output.CustomerPathRootDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Configuration.Output.CustomerPathSaveEnabled}" Margin="0,0,8,12" />
                            <Button Grid.Row="5" Grid.Column="2" Content="浏览" Style="{StaticResource FolderPickerButton}" Click="SelectCustomerPathRootDirectory_Click" IsEnabled="{Binding Configuration.Output.CustomerPathSaveEnabled}" Margin="0,0,0,12" />
                            <CheckBox Grid.Row="6" Grid.Column="1" Content="启用每片单独 CSV" IsChecked="{Binding Configuration.Output.SinglePieceCsvEnabled}" Margin="0,0,0,12" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="单片 CSV 保存路径" Margin="0,0,12,12" VerticalAlignment="Center" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Configuration.Output.SinglePieceCsvDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Configuration.Output.SinglePieceCsvEnabled}" Margin="0,0,8,12" />
                            <Button Grid.Row="7" Grid.Column="2" Content="浏览" Style="{StaticResource FolderPickerButton}" Click="SelectSinglePieceCsvDirectory_Click" IsEnabled="{Binding Configuration.Output.SinglePieceCsvEnabled}" Margin="0,0,0,12" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="单片 CSV 名称规则" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="8" Grid.Column="1">
                                <TextBox Text="{Binding Configuration.Output.SinglePieceCsvFileName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Configuration.Output.SinglePieceCsvEnabled}" />
                                <TextBlock Foreground="#94A3B8" FontSize="11" Text="可用变量：{Result}、{SN}、{Time}、{Name}，例如 {Result}_{SN}_{Time}.csv" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
