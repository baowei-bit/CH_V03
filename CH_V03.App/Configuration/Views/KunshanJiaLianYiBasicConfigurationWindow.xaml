<Window x:Class="CH_V03.App.Views.KunshanJiaLianYiBasicConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="基础资料" Width="820" Height="610" WindowStartupLocation="CenterOwner" Background="#EAF7FF">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="8,3" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,5" /><Setter Property="Foreground" Value="#52606D" /></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#7DD3FC" BorderThickness="1,1,0,0" Padding="14"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="保存" Command="{Binding SaveCommand}" Width="96" Height="34" Margin="0,0,10,0" /><Button Content="退出" Command="{Binding CancelCommand}" Width="96" Height="34" /></StackPanel></Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
            <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="基础资料" /><UniformGrid Columns="3"><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="客户名称" /><TextBox Text="{Binding Configuration.Identity.CustomerName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="产品名称" /><TextBox Text="{Binding Configuration.Identity.ProductName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="测试类型" /><TextBox Text="{Binding Configuration.Identity.TestType, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="测试程序" /><TextBox Text="{Binding Configuration.Identity.TestProgram, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="品号" /><TextBox Text="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="用于 CSV 文件命名" Foreground="#64748B" FontSize="12" Margin="0,4,0,0" /></StackPanel><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="条码固定校验码" /><TextBox Text="{Binding Configuration.Identity.CodeSuffix, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="留空则不校验" Foreground="#64748B" FontSize="12" Margin="0,4,0,0" /></StackPanel><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="条码长度" /><TextBox Text="{Binding Configuration.Identity.BarcodeLength, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="留空则不校验条码位数" Foreground="#64748B" FontSize="12" Margin="0,4,0,0" /></StackPanel></UniformGrid></StackPanel></Border>
            <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="功能开关" />
                    <CheckBox Content="特殊项测试值隐藏" IsChecked="{Binding Configuration.User.HideSpecialItemTestValues}" ToolTip="隐藏 s03 ref 和 swipe phase0/phase1 offset/diff 项在主界面的测试值。" />
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="连接状态" /><UniformGrid Columns="3"><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="扫码枪" /><Button Content="{Binding ScannerState}" Command="{Binding ToggleScannerCommand}" IsEnabled="False" Height="32" /></StackPanel><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="下位机" /><Button Content="{Binding LowerMachineState}" Command="{Binding ToggleLowerMachineCommand}" IsEnabled="False" Height="32" /></StackPanel><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="MES" /><Button Content="{Binding MesState}" Command="{Binding ToggleMesCommand}" IsEnabled="False" Height="32" /></StackPanel></UniformGrid><TextBlock Text="昆山嘉联益专用模式启动后会自动连接扫码枪和下位机；此处仅显示当前连接状态。" Foreground="#64748B" /></StackPanel></Border>
            <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="嘉联益运行模式" /><TextBlock Text="MES 在线时可选择；每天 08:00 和 20:00 自动恢复为标准片模式。" Foreground="#64748B" Margin="0,0,0,12" /><StackPanel Orientation="Horizontal"><Button Content="标准片模式" Command="{Binding SelectStandardPieceModeCommand}" IsEnabled="{Binding CanSelectRunMode}" MinWidth="130" Height="34" Margin="0,0,10,0"><Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsStandardPieceMode}" Value="True"><Setter Property="Background" Value="#FACC15" /><Setter Property="Foreground" Value="#1F2937" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="生产模式" Command="{Binding SelectTestPieceModeCommand}" IsEnabled="{Binding CanSelectRunMode}" MinWidth="130" Height="34" Margin="0,0,10,0"><Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsTestPieceMode}" Value="True"><Setter Property="Background" Value="#16A34A" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="调试模式" Command="{Binding SelectDebugModeCommand}" IsEnabled="{Binding CanSelectRunMode}" MinWidth="130" Height="34"><Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsDebugMode}" Value="True"><Setter Property="Background" Value="#DC2626" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></StackPanel></Border>
        </StackPanel></ScrollViewer>
    </DockPanel>
</Window>
