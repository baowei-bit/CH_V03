<Window x:Class="CH_V03.App.Views.CommunicationConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CH_V03.App.Converters"
        xmlns:config="clr-namespace:CH_V03.Core.Configuration;assembly=CH_V03.Core"
        Title="通讯设置"
        Width="920"
        Height="620"
        MinWidth="820"
        MinHeight="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#EAF7FF">
    <Window.Resources>
        <converters:ConfigurationFieldVisibilityConverter x:Key="FieldVisibility" />
        <converters:ConnectionTypeDisplayConverter x:Key="ConnectionTypeDisplay" />
        <DataTemplate x:Key="ConnectionTypeItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ConnectionTypeDisplay}}" />
        </DataTemplate>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="#52606D" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SerialFields" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionType}" Value="{x:Static config:ConnectionType.SerialPort}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TcpFields" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionType}" Value="{x:Static config:ConnectionType.TcpClient}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ConnectionType}" Value="{x:Static config:ConnectionType.TcpServer}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#7DD3FC" BorderThickness="1,1,0,0" Padding="14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Command="{Binding SaveCommand}" Width="96" Height="34" Margin="0,0,10,0" />
                <Button Content="退出" Command="{Binding CancelCommand}" Width="96" Height="34" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Style="{StaticResource SectionTitle}" Text="通讯设置" />
                <UniformGrid Columns="2">
                    <GroupBox Header="扫码枪" Padding="14" Margin="0,0,10,0" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Communication.Scanner}">
                        <StackPanel DataContext="{Binding Configuration.Communication.Scanner}">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Label}" Text="通讯方式" />
                                <ComboBox x:Name="ScannerConnectionTypeBox"
                                          ItemsSource="{Binding DataContext.ScannerConnectionTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ItemTemplate="{StaticResource ConnectionTypeItemTemplate}"
                                          SelectedItem="{Binding ConnectionType, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScannerConnectionTypeBox}" Value="{x:Static config:ConnectionType.CameraQr}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="USB Video Device / UVC 摄像头扫码" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource Label}" Text="摄像头编号（从 0 开始）" />
                                <ComboBox ItemsSource="{Binding DataContext.CameraIndexes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding CameraIndex, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                <TextBlock Style="{StaticResource Label}" Text="分辨率（宽 × 高，可输入自定义值）" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.CameraResolutions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Text="{Binding DataContext.CameraResolution, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Style="{StaticResource Label}" Text="帧率（FPS）" />
                                        <TextBox Text="{Binding CameraFrameRate, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource Label}" Text="识码等待（ms）" />
                                        <TextBox Text="{Binding CameraScanTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="使用手动对焦。保存后在主界面连接扫码枪，生产触发时识别二维码 / Data Matrix。请选择设备支持的分辨率；如设备不支持，驱动可能采用其他分辨率。相机预览可查看实际画面。" TextWrapping="Wrap" Foreground="#52606D" />
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel" BasedOn="{StaticResource SerialFields}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScannerConnectionTypeBox}" Value="{x:Static config:ConnectionType.SerialPort}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Style="{StaticResource Label}" Text="串口号" />
                                        <ComboBox ItemsSource="{Binding DataContext.SerialPorts, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource Label}" Text="波特率" />
                                        <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel" BasedOn="{StaticResource TcpFields}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScannerConnectionTypeBox}" Value="{x:Static config:ConnectionType.TcpClient}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScannerConnectionTypeBox}" Value="{x:Static config:ConnectionType.TcpServer}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Style="{StaticResource Label}" Text="IP 地址" />
                                        <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource Label}" Text="端口" />
                                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScannerConnectionTypeBox}" Value="{x:Static config:ConnectionType.CameraQr}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScannerConnectionTypeBox}" Value="{x:Static config:ConnectionType.UsbPosHid}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScannerConnectionTypeBox}" Value="{x:Static config:ConnectionType.Disabled}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource Label}" Text="超时(ms)" />
                                <TextBox Text="{Binding TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>


                            <Border BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScannerConnectionTypeBox}" Value="{x:Static config:ConnectionType.CameraQr}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScannerConnectionTypeBox}" Value="{x:Static config:ConnectionType.UsbPosHid}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScannerConnectionTypeBox}" Value="{x:Static config:ConnectionType.Disabled}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.Configuration.Compatibility.EnableKunshanJiaLianYiDedicatedConfiguration, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                     <CheckBox Content="自动扫码触发"
                                               IsChecked="{Binding DataContext.Configuration.Communication.ScannerTriggerEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Margin="0,0,0,10" />
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource Label}" Text="扫码等待超时（秒）" />
                                        <TextBox Text="{Binding DataContext.Configuration.Communication.ScannerWaitTimeoutSeconds, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Foreground="#94A3B8" FontSize="11" Text="默认 10 秒；超时后向下位机发送 DMNG" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource Label}" Text="扫码触发命令" />
                                        <TextBox Text="{Binding DataContext.Configuration.Communication.ScannerTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Text="扫码停止命令" />
                                        <TextBox Text="{Binding DataContext.Configuration.Communication.ScannerStopCommand, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScannerConnectionTypeBox}" Value="{x:Static config:ConnectionType.UsbPosHid}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="USB POS HID" Margin="0,0,0,6" />
                                    <TextBlock Foreground="#52606D"
                                               Text="由 Windows 自动识别并连接 POS HID 条形码扫描器。该模式无需串口号、波特率及触发命令，请按扫码枪按钮扫码。"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Button Content="测试扫码枪连接"
                                    Command="{Binding DataContext.TestScannerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Focusable="False"
                                    Height="34" />
                            <TextBlock Text="{Binding DataContext.ScannerTestMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="#52606D"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                            <TextBlock Foreground="#94A3B8"
                                       FontSize="11"
                                       Text="连接测试完成后会释放设备；正式扫码请保存并退出本页，然后在主界面连接扫码枪。"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="下位机" Padding="14" Margin="10,0,0,0" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Communication.LowerMachine}">
                        <StackPanel DataContext="{Binding Configuration.Communication.LowerMachine}">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Label}" Text="通讯方式" />
                                <ComboBox x:Name="LowerMachineConnectionTypeBox"
                                          ItemsSource="{Binding DataContext.LowerMachineConnectionTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ItemTemplate="{StaticResource ConnectionTypeItemTemplate}"
                                          SelectedItem="{Binding ConnectionType, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel" BasedOn="{StaticResource SerialFields}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=LowerMachineConnectionTypeBox}" Value="{x:Static config:ConnectionType.SerialPort}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Style="{StaticResource Label}" Text="串口号" />
                                        <ComboBox ItemsSource="{Binding DataContext.SerialPorts, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource Label}" Text="波特率" />
                                        <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel" BasedOn="{StaticResource TcpFields}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=LowerMachineConnectionTypeBox}" Value="{x:Static config:ConnectionType.TcpClient}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=LowerMachineConnectionTypeBox}" Value="{x:Static config:ConnectionType.TcpServer}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Style="{StaticResource Label}" Text="IP 地址" />
                                        <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource Label}" Text="端口" />
                                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Label}" Text="超时(ms)" />
                                <TextBox Text="{Binding TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Border BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility"
                                                Value="{Binding DataContext.Configuration.Compatibility.VisibleConfigurationFields, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FieldVisibility}, ConverterParameter=Communication.TestItemRequest}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Configuration.Compatibility.EnableKunshanJiaLianYiDedicatedConfiguration, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <CheckBox Content="连接后请求测试项"
                                              IsChecked="{Binding DataContext.Configuration.Communication.TestItemRequestEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Margin="0,0,0,10" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Text="请求测试项命令" />
                                        <TextBox Text="{Binding DataContext.Configuration.Communication.TestItemRequestCommand, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Configuration.Compatibility.EnableKunshanJiaLianYiDedicatedConfiguration, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <CheckBox Content="条码验证成功后同时发送默认 OK 命令"
                                              IsChecked="{Binding DataContext.Configuration.Communication.BarcodeSendDefaultOkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Margin="0,0,0,10" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Text="条码内容到成功命令映射" />
                                        <TextBox Text="{Binding DataContext.Configuration.Communication.BarcodeSuccessCommandByValue, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button Content="测试下位机连接"
                                    Command="{Binding DataContext.TestLowerMachineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Height="34" />
                            <TextBlock Text="{Binding DataContext.LowerMachineTestMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="#52606D"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </GroupBox>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

