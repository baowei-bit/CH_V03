<Window x:Class="CH_V03.App.Views.TestTrendAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:analysis="clr-namespace:CH_V03.App.Analysis"
        Title="测试趋势分析" Width="1180" Height="860" MinWidth="980" MinHeight="700" WindowStartupLocation="CenterOwner" Background="#EAF7FF">
    <Window.Resources>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="30" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style x:Key="TrendCardButton" TargetType="Button"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,12,12" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style>
        <Style x:Key="AbnormalCell" TargetType="DataGridCell"><Style.Triggers><DataTrigger Binding="{Binding IsAbnormal}" Value="True"><Setter Property="Foreground" Value="#B91C1C" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Background" Value="#FEF2F2" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="FailedResultCell" TargetType="DataGridCell"><Style.Triggers><DataTrigger Binding="{Binding IsFailedResult}" Value="True"><Setter Property="Foreground" Value="#B91C1C" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Background" Value="#FEF2F2" /></DataTrigger></Style.Triggers></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#7DD3FC" BorderThickness="1,1,0,0" Padding="14"><Button Content="关闭" Command="{Binding CloseCommand}" Width="96" Height="34" HorizontalAlignment="Right" /></Border>
        <Grid Margin="18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="310" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="最近测试数量" VerticalAlignment="Center" Foreground="#52606D" /><ComboBox Grid.Column="1" ItemsSource="{Binding RecordCountChoices}" SelectedItem="{Binding SelectedRecordCount}" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="2" Text="测试项/点位" VerticalAlignment="Center" Foreground="#52606D" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding ItemChoices}" IsEditable="True" IsReadOnly="True" StaysOpenOnEdit="True" Text="{Binding SelectedItemsSummary, Mode=OneWay}" Margin="0,0,14,0">
                        <ComboBox.ItemTemplate><DataTemplate><Border Padding="5,3"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasFailures}" Value="True"><Setter Property="Background" Value="#FEF2F2" /></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions><CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding FailureSummary}" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B" /><Style.Triggers><DataTrigger Binding="{Binding HasFailures}" Value="True"><Setter Property="Foreground" Value="#B91C1C" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="4" Content="刷新" Command="{Binding RefreshCommand}" />
                    <StackPanel Grid.ColumnSpan="5" Margin="0,38,0,0"><TextBlock Text="{Binding RecordInfo}" Foreground="#64748B" FontSize="12" /><TextBlock Text="{Binding SelectionLimitMessage}" Foreground="#B91C1C" FontSize="12" /></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="10">
                <DockPanel><TextBlock DockPanel.Dock="Top" Text="趋势对比（蓝线为测试值，橙色虚线为当次上下限，红点为异常；点击图表查看明细）" FontWeight="SemiBold" Margin="0,0,0,8" /><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Series}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource TrendCardButton}" Command="{Binding DataContext.SelectSeriesCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><Border Width="520" Height="248" Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="6" Padding="8"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Choice.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding AbnormalSummary}" Foreground="#B91C1C" /></Grid><TextBlock DockPanel.Dock="Top" Text="{Binding Statistics}" Foreground="#64748B" FontSize="12" Margin="0,0,0,4" /><analysis:TestTrendChart Samples="{Binding Samples}" Height="174" /></DockPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel>
            </Border>
            <Border Grid.Row="4" Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="10">
                <DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding DetailTitle}" FontWeight="SemiBold" Margin="0,0,0,8" /><DataGrid ItemsSource="{Binding DetailSamples}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All"><DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="45" /><DataGridTextColumn Header="时间" Binding="{Binding EndTime, StringFormat=yyyy/MM/dd HH:mm:ss}" Width="150" /><DataGridTextColumn Header="条码" Binding="{Binding Barcode}" Width="*" /><DataGridTextColumn Header="点位A" Binding="{Binding PointA}" Width="80" /><DataGridTextColumn Header="点位B" Binding="{Binding PointB}" Width="80" /><DataGridTextColumn Header="下限" Binding="{Binding LowerLimit}" Width="85" /><DataGridTextColumn Header="上限" Binding="{Binding UpperLimit}" Width="85" /><DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="70" /><DataGridTextColumn Header="测试值" Binding="{Binding TestValue}" CellStyle="{StaticResource AbnormalCell}" Width="100" /><DataGridTextColumn Header="结果" Binding="{Binding Result}" CellStyle="{StaticResource FailedResultCell}" Width="70" />
                </DataGrid.Columns></DataGrid></DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
