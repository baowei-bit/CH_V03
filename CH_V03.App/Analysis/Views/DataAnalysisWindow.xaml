<Window x:Class="CH_V03.App.Views.DataAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据分析"
        Width="920"
        Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#EAF7FF">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#7DD3FC" BorderThickness="1,1,0,0" Padding="14">
            <Button Content="关闭" Command="{Binding CloseCommand}" Width="96" Height="34" HorizontalAlignment="Right" />
        </Border>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <UniformGrid Columns="5">
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="总数" Foreground="#52606D" />
                        <TextBlock Text="{Binding TotalCount}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="PASS" Foreground="#52606D" />
                        <TextBlock Text="{Binding PassCount}" FontSize="26" FontWeight="SemiBold" Foreground="#047857" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="FAIL" Foreground="#52606D" />
                        <TextBlock Text="{Binding FailCount}" FontSize="26" FontWeight="SemiBold" Foreground="#B91C1C" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="良率" Foreground="#52606D" />
                        <TextBlock Text="{Binding YieldRateText}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="连续NG/最高失败项" Foreground="#52606D" />
                        <TextBlock Text="{Binding CurrentConsecutiveNg}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WorstFailItem}" Foreground="#52606D" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="本次失败记录" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding RecordsView}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding EndTime, StringFormat=yyyy/MM/dd HH:mm:ss}" SortMemberPath="EndTime" SortDirection="Descending" Width="150" />
                            <DataGridTextColumn Header="条码" Binding="{Binding Barcode}" Width="*" />
                            <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="90" />
                            <DataGridTextColumn Header="失败项" Binding="{Binding FirstFailItem}" Width="180" />
                            <DataGridTextColumn Header="耗时(s)" Binding="{Binding TestSeconds}" Width="90" />
                            <DataGridTextColumn Header="项目数" Binding="{Binding ItemCount}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
