<Window x:Class="CH_V03.App.Views.AirtightnessHistoryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="气密检测 · 测试记录" Width="1180" Height="650" MinWidth="800" MinHeight="420"
 WindowStartupLocation="CenterOwner" Background="#EAF7FF" FontFamily="Microsoft YaHei UI" Icon="/CeHao;component/Assets/company-icon.png">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="刷新记录" Click="Refresh_Click"/><StackPanel><TextBlock Text="气密测试记录" FontSize="23" FontWeight="SemiBold" Foreground="#164E63"/><TextBlock Text="{Binding CountingNote}" Margin="0,5,0,0" Foreground="#64748B"/></StackPanel></DockPanel>
  <TabControl Grid.Row="1"><TabItem Header="正式记录 · 当前模式最近100轮"><DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="32" HeadersVisibility="Column" AlternatingRowBackground="#F0F9FF"><DataGrid.Columns><DataGridTextColumn Header="测试时间" Binding="{Binding Time}" Width="160" MinWidth="80"/>
<DataGridTextColumn Header="产品" Binding="{Binding Product}" Width="*" MinWidth="80"/>
<DataGridTextColumn Header="CH1 kPa" Binding="{Binding Pressure1}" Width="85" MinWidth="80"/>
<DataGridTextColumn Header="CH1 Pa" Binding="{Binding Leak1}" Width="85" MinWidth="80"/>
<DataGridTextColumn Header="CH2 kPa" Binding="{Binding Pressure2}" Width="85" MinWidth="80"/>
<DataGridTextColumn Header="CH2 Pa" Binding="{Binding Leak2}" Width="85" MinWidth="80"/>
<DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="200" MinWidth="80"/>
<DataGridTextColumn Header="操作员" Binding="{Binding Operator}" Width="95" MinWidth="80"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="模拟记录 · 本次运行最近100轮"><DataGrid ItemsSource="{Binding SimulationHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="32" HeadersVisibility="Column" AlternatingRowBackground="#F0F9FF"><DataGrid.Columns><DataGridTextColumn Header="测试时间" Binding="{Binding Time}" Width="160" MinWidth="80"/>
<DataGridTextColumn Header="产品" Binding="{Binding Product}" Width="*" MinWidth="80"/>
<DataGridTextColumn Header="CH1 kPa" Binding="{Binding Pressure1}" Width="85" MinWidth="80"/>
<DataGridTextColumn Header="CH1 Pa" Binding="{Binding Leak1}" Width="85" MinWidth="80"/>
<DataGridTextColumn Header="CH2 kPa" Binding="{Binding Pressure2}" Width="85" MinWidth="80"/>
<DataGridTextColumn Header="CH2 Pa" Binding="{Binding Leak2}" Width="85" MinWidth="80"/>
<DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="200" MinWidth="80"/>
<DataGridTextColumn Header="操作员" Binding="{Binding Operator}" Width="95" MinWidth="80"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
  <TextBlock Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#64748B"><Run Text="正式记录目录："/><Run Text="{Binding RecordsDirectory, Mode=OneWay}"/><LineBreak/><Run Text="模拟记录仅用于演示，不写入正式记录目录，不计入生产统计。"/></TextBlock>
 </Grid>
</Window>
