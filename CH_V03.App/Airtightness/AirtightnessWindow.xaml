<Window x:Class="CH_V03.App.Views.AirtightnessWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:gas="clr-namespace:CH_V03.App.Airtightness"
 Title="{Binding WindowTitle}" Width="1260" Height="820" MinWidth="1024" MinHeight="720"
 WindowState="Maximized" WindowStartupLocation="CenterScreen" Icon="/CeHao;component/Assets/company-icon.png" WindowStyle="None" ResizeMode="CanResize"
 Background="#EAF7FF" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#7DD3FC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#164E63"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
  <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="Foreground" Value="#0F4C81"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="OuterStatusItem" TargetType="Button">
   <Setter Property="Background" Value="#F8FCFF"/><Setter Property="BorderBrush" Value="#BAE6FD"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="ToolTip" Value="点击切换连接状态"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="StatusItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StatusItemBorder" Property="Background" Value="#E0F2FE"/><Setter TargetName="StatusItemBorder" Property="BorderBrush" Value="#38BDF8"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="StatusItemBorder" Property="Background" Value="#BAE6FD"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TitleBarButton" TargetType="Button"><Setter Property="Width" Value="45"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#0F4C81"/><Setter Property="FontSize" Value="16"/></Style>
  <Style x:Key="CloseTitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DC2626"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Background="#E0F2FE">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,16,0"><Image Source="/CeHao;component/Assets/company-icon.png" Width="20" Height="20" Margin="0,0,6,0"/><TextBlock Text="{Binding WindowTitle}" Foreground="#0F4C81" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
    <Button Style="{StaticResource OuterStatusItem}" Click="ToggleScannerConnection_Click" ToolTip="点击连接或断开扫码枪" shell:WindowChrome.IsHitTestVisibleInChrome="True"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="{Binding ScannerStateBrush}" Margin="0,0,6,0"/><TextBlock Text="扫码枪" Foreground="#0F4C81" FontWeight="SemiBold"/></StackPanel></Button>
    <Button Style="{StaticResource OuterStatusItem}" Click="ToggleInstrumentConnection_Click" ToolTip="点击连接或断开气密仪" shell:WindowChrome.IsHitTestVisibleInChrome="True"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="{Binding InstrumentStateBrush}" Margin="0,0,6,0"/><TextBlock Text="气密仪" Foreground="#0F4C81" FontWeight="SemiBold"/></StackPanel></Button>
    <Button Style="{StaticResource OuterStatusItem}" Click="ToggleMotionConnection_Click" ToolTip="点击连接或断开下位机" shell:WindowChrome.IsHitTestVisibleInChrome="True"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="{Binding MotionStateBrush}" Margin="0,0,6,0"/><TextBlock Text="下位机" Foreground="#0F4C81" FontWeight="SemiBold"/></StackPanel></Button>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource TitleBarButton}" Content="—" Click="Minimize_Click"/><Button Style="{StaticResource TitleBarButton}" Content="□" Click="Maximize_Click"/><Button Style="{StaticResource CloseTitleBarButton}" Content="×" Click="Close_Click"/></StackPanel>
  </Grid>
 <DockPanel Grid.Row="1">
  <Border DockPanel.Dock="Top" Background="#DDF3FF" Padding="14,10" BorderBrush="#7DD3FC" BorderThickness="0,0,0,1">
   <DockPanel LastChildFill="False">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding LoginDisplay}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
     <Button Content="基础配置" IsEnabled="{Binding CanConfigure}" Click="BasicConfiguration_Click" Margin="0,0,6,0" Padding="10,6"/><Button Content="设备连接" IsEnabled="{Binding CanConfigure}" Click="DeviceConnection_Click" Margin="0,0,6,0" Padding="10,6"/>
     <Button Content="测试记录" Click="ShowHistory_Click" Margin="0,0,6,0" Padding="10,6"/>
     <Button Content="显示日志" Click="ShowLogs_Click" Margin="0,0,6,0" Padding="10,6"/>
     <Button Content="气密配置" IsEnabled="{Binding CanConfigure}" Click="Configure_Click" Margin="0,0,6,0" Padding="10,6"/>
     <Button Content="切换账号" IsEnabled="{Binding CanSwitchAccount}" Click="SwitchAccount_Click" Padding="10,6"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="#DDF3FF" Padding="14,6"><TextBlock Text="{Binding SimulationSummary}" Foreground="#92400E" FontSize="12"/></Border>
  <Grid Margin="14,10">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,10">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding SimulationButtonText}" Click="Simulate_Click" Width="112" Margin="0,0,8,0"/><Button Content="准备等待 Start" Click="PrepareInstrumentTest_Click" IsEnabled="{Binding CanArmInstrumentTest}" Width="126" Margin="0,0,8,0" ToolTip="仅在不扫码模式下启用；开始等待设备面板 Start 和压力变化，不发送启动命令。"/><Button Content="停止等待/测试" Click="StopInstrumentTest_Click" IsEnabled="{Binding CanStopInstrumentMonitoring}" Width="128" Margin="0,0,8,0" ToolTip="停止持续等待或正在进行的实时采集；气密仪会保持或自动恢复连接。"/><Button Content="一键清除当前记录" Click="ClearCurrentStatistics_Click" IsEnabled="{Binding CanClearCurrentStatistics}" Width="142" ToolTip="将当前 PASS、FAIL、总数、良率和当前列表清零；不会删除 CSV 或正式测试档案。"/></StackPanel>
   </DockPanel>
   <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
    <Border Style="{StaticResource Panel}" Margin="0,0,6,0"><StackPanel><TextBlock Text="生产测试总数 / 件" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Statistics.Total}" FontSize="29" FontWeight="Bold" Foreground="#164E63"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}" Margin="0,0,6,0"><StackPanel><TextBlock Text="生产 PASS / 件" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Statistics.Pass}" FontSize="29" FontWeight="Bold" Foreground="#16A34A"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}" Margin="0,0,6,0"><StackPanel><TextBlock Text="生产 FAIL / 件" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Statistics.Fail}" FontSize="29" FontWeight="Bold" Foreground="#DC2626"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}" Margin="0,0,6,0"><StackPanel><TextBlock Text="生产合格率" Style="{StaticResource Caption}"/><TextBlock Text="{Binding YieldText}" FontSize="29" FontWeight="Bold" Foreground="#0284C7"/></StackPanel></Border>
   </UniformGrid>
   <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,10"><UniformGrid Columns="6">
    <StackPanel><TextBlock Text="测试气压" Style="{StaticResource Caption}"/><TextBlock Text="{Binding PressureRange}" Style="{StaticResource Metric}"/></StackPanel><StackPanel><TextBlock Text="充气时间" Style="{StaticResource Caption}"/><TextBlock Text="{Binding FillTime}" Style="{StaticResource Metric}"/></StackPanel><StackPanel><TextBlock Text="平衡时间" Style="{StaticResource Caption}"/><TextBlock Text="{Binding BalanceTime}" Style="{StaticResource Metric}"/></StackPanel><StackPanel><TextBlock Text="测试时间" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TestTime}" Style="{StaticResource Metric}"/></StackPanel><StackPanel><TextBlock Text="泄气时间" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ExhaustTime}" Style="{StaticResource Metric}"/></StackPanel><StackPanel><TextBlock Text="泄漏压降上限" Style="{StaticResource Caption}"/><TextBlock Text="{Binding LeakLimit}" Style="{StaticResource Metric}"/></StackPanel>
   </UniformGrid></Border>
   <UniformGrid Grid.Row="3" Columns="2" Margin="0,0,0,10"><Border Style="{StaticResource Panel}" Margin="0,0,6,0"><StackPanel><DockPanel><Border DockPanel.Dock="Right" Background="{Binding Channel1ResultBackground}" BorderBrush="{Binding Channel1ResultBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,3"><TextBlock Text="{Binding Channel1State}" Foreground="{Binding Channel1ResultForeground}" FontSize="22" FontWeight="ExtraBold"/></Border><TextBlock Text="CH1 · 通道一" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="16"/></DockPanel><StackPanel Visibility="{Binding IsNoScanMode, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="不扫码模式" Foreground="#64748B" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Visibility="{Binding IsManualScanMode, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="CH1 产品条码（扫码后按 Enter 自动切换 CH2）" Style="{StaticResource Caption}" Margin="0,5,0,0"/><TextBox x:Name="Channel1BarcodeInput" Text="{Binding Channel1Barcode, Mode=OneWay}" KeyDown="Channel1BarcodeInput_KeyDown" Padding="7,4"/></StackPanel><StackPanel Visibility="{Binding IsAutomaticScanMode, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="CH1 自动扫码条码" Style="{StaticResource Caption}" Margin="0,5,0,0"/><TextBlock Text="{Binding Channel1Barcode}" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel><UniformGrid Columns="3" Margin="0,6,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="气压 / kPa  " VerticalAlignment="Center"/><TextBlock Text="{Binding Pressure1Text}" Style="{StaticResource Metric}"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="压降 / Pa  " VerticalAlignment="Center"/><TextBlock Text="{Binding Leak1Text}" Style="{StaticResource Metric}"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="仪器结果码 /  " VerticalAlignment="Center"/><TextBlock Text="{Binding InstrumentResult1Text}" Style="{StaticResource Metric}"/></StackPanel></UniformGrid></StackPanel></Border><Border Style="{StaticResource Panel}" Margin="0,0,6,0"><StackPanel><DockPanel><Border DockPanel.Dock="Right" Background="{Binding Channel2ResultBackground}" BorderBrush="{Binding Channel2ResultBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,3"><TextBlock Text="{Binding Channel2State}" Foreground="{Binding Channel2ResultForeground}" FontSize="22" FontWeight="ExtraBold"/></Border><TextBlock Text="CH2 · 通道二" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="16"/></DockPanel><StackPanel Visibility="{Binding IsManualScanMode, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="CH2 产品条码（扫码后按 Enter 确认）" Style="{StaticResource Caption}" Margin="0,5,0,0"/><TextBox x:Name="Channel2BarcodeInput" Text="{Binding Channel2Barcode, Mode=OneWay}" KeyDown="Channel2BarcodeInput_KeyDown" Padding="7,4"/></StackPanel><StackPanel Visibility="{Binding IsAutomaticScanMode, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="CH2 自动扫码条码" Style="{StaticResource Caption}" Margin="0,5,0,0"/><TextBlock Text="{Binding Channel2Barcode}" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel><UniformGrid Columns="3" Margin="0,6,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="气压 / kPa  " VerticalAlignment="Center"/><TextBlock Text="{Binding Pressure2Text}" Style="{StaticResource Metric}"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="压降 / Pa  " VerticalAlignment="Center"/><TextBlock Text="{Binding Leak2Text}" Style="{StaticResource Metric}"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="仪器结果码 /  " VerticalAlignment="Center"/><TextBlock Text="{Binding InstrumentResult2Text}" Style="{StaticResource Metric}"/></StackPanel></UniformGrid></StackPanel></Border></UniformGrid>
   <Grid Grid.Row="4">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding SimulationSummary}" Foreground="#92400E" FontSize="12" Margin="0,0,0,6"/>
        <UniformGrid Grid.Row="1" Columns="2">
     <Border Style="{StaticResource Panel}" Margin="0,0,6,0"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="CH1 · 通道一压力波形" Foreground="DodgerBlue" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <gas:PressureWaveform Grid.Row="1" Channel="1" Samples="{Binding PressureSamples}" Duration="{Binding WaveformDuration}" Maximum="{Binding WaveformMaximum}" FillSeconds="{Binding WaveformFillSeconds}" BalanceSeconds="{Binding WaveformBalanceSeconds}" TestSeconds="{Binding WaveformTestSeconds}" ExhaustSeconds="{Binding WaveformExhaustSeconds}"/>
     </Grid></Border>
     <Border Style="{StaticResource Panel}" Margin="0,0,6,0"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="CH2 · 通道二压力波形" Foreground="DarkOrange" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <gas:PressureWaveform Grid.Row="1" Channel="2" Samples="{Binding PressureSamples}" Duration="{Binding WaveformDuration}" Maximum="{Binding WaveformMaximum}" FillSeconds="{Binding WaveformFillSeconds}" BalanceSeconds="{Binding WaveformBalanceSeconds}" TestSeconds="{Binding WaveformTestSeconds}" ExhaustSeconds="{Binding WaveformExhaustSeconds}"/>
     </Grid></Border>
    </UniformGrid>
   </Grid>
  </Grid>
 </DockPanel>
 </Grid>
</Window>
