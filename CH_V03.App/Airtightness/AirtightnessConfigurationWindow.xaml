<Window x:Class="CH_V03.App.Views.AirtightnessConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="气密检测配置" Width="780" Height="780" MinWidth="640" MinHeight="600" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#EAF7FF" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#164E63"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,4"/><Setter Property="BorderBrush" Value="#7DD3FC"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Text="气密检测配置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="博仪 BYD-100Z-22 · 两通道" Margin="0,6,0,0"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="产品名称"/><TextBox x:Name="Product" Grid.Column="1"/>
            <TextBlock Grid.Row="1" Text="统计模式"/><ComboBox x:Name="CountingMode" Grid.Row="1" Grid.Column="1" Margin="0,6" Padding="6" SelectedIndex="0"><ComboBoxItem Content="两个产品：每个通道独立计数"/><ComboBoxItem Content="一个产品：两通道均合格才 PASS"/></ComboBox>
            <TextBlock Grid.Row="2" Text="扫码模式"/><ComboBox x:Name="ScanMode" Grid.Row="2" Grid.Column="1" Margin="0,6" Padding="6"><ComboBoxItem Content="手动扫码：CH1 后自动切换 CH2"/><ComboBoxItem Content="自动扫码：扫码枪按 CH1、CH2 顺序接收"/><ComboBoxItem Content="不扫码：不要求条码"/></ComboBox>
            <TextBlock Grid.Row="3" Text="测试气压下限 / kPa"/><TextBox x:Name="MinimumPressure" Grid.Row="3" Grid.Column="1"/>
            <TextBlock Grid.Row="4" Text="测试气压上限 / kPa"/><TextBox x:Name="MaximumPressure" Grid.Row="4" Grid.Column="1"/>
            <TextBlock Grid.Row="5" Text="充气时间 / s"/><TextBox x:Name="Fill" Grid.Row="5" Grid.Column="1"/>
            <TextBlock Grid.Row="6" Text="平衡时间 / s"/><TextBox x:Name="Balance" Grid.Row="6" Grid.Column="1"/>
            <TextBlock Grid.Row="7" Text="测试时间 / s"/><TextBox x:Name="Test" Grid.Row="7" Grid.Column="1"/>
            <TextBlock Grid.Row="8" Text="泄气时间 / s"/><TextBox x:Name="Exhaust" Grid.Row="8" Grid.Column="1"/>
            <TextBlock Grid.Row="9" Text="泄漏压降上限 / Pa"/><TextBox x:Name="MaximumLeak" Grid.Row="9" Grid.Column="1"/>
            <TextBlock Grid.Row="10" Text="测试记录保存路径"/>
            <DockPanel Grid.Row="10" Grid.Column="1">
                <Button DockPanel.Dock="Right" Content="浏览" Click="SelectRecordsDirectory_Click" Padding="12,2" Margin="8,4,0,4" Background="#F0F9FF" Foreground="#0369A1" BorderBrush="#7DD3FC"/>
                <TextBox x:Name="RecordsDirectory" ToolTip="选择测试记录保存文件夹"/>
            </DockPanel>
            <TextBlock Grid.Row="11" Text="日志保存路径"/>
            <DockPanel Grid.Row="11" Grid.Column="1">
                <Button DockPanel.Dock="Right" Content="浏览" Click="SelectLogDirectory_Click" Padding="12,2" Margin="8,4,0,4" Background="#F0F9FF" Foreground="#0369A1" BorderBrush="#7DD3FC"/>
                <TextBox x:Name="LogDirectory" ToolTip="选择运行日志保存文件夹"/>
            </DockPanel>
        </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12">
            <TextBlock Text="两种模式分别累计统计，保存后展示所选模式的数量。" TextWrapping="Wrap"/>
            <TextBlock Text="路径保存后立即生效；读取新目录的测试记录，旧目录文件保留，不自动搬移。" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock Text="保存配置会写入并回读核对气密仪：充气、稳压、检测、排气、进气上下限及泄漏上限。请先在“设备连接”中连接气密仪。" Foreground="#92400E" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="Error" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="Success" Foreground="#16A34A" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SaveButton" Content="保存配置" Click="Save_Click" Margin="0,0,10,0"/><Button x:Name="CancelButton" Content="取消" IsCancel="True"/></StackPanel>
        <Border x:Name="SyncOverlay" Grid.RowSpan="4" Background="#B3FFFFFF" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Width="390" Padding="26" Background="White" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="正在同步气密仪配置" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="12" Margin="0,18,0,14" Foreground="#0EA5E9"/>
                    <TextBlock Text="正在同步 CH1、CH2 各 7 项参数，并逐项回读核对。请勿关闭窗口或断开气密仪。" TextWrapping="Wrap" TextAlignment="Center" Foreground="#475569"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
