<Window x:Class="CH_V03.App.Views.AirtightnessConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="气密工艺配置" Width="760" Height="700" MinWidth="620" MinHeight="540" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#EAF7FF" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#164E63"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,4"/><Setter Property="BorderBrush" Value="#7DD3FC"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Text="气密工艺配置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="博仪 BYD-100Z-22 · 两通道。保存后将测试工艺参数写入并回读核对气密仪。" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="测试气压下限 / kPa"/><TextBox x:Name="MinimumPressure" Grid.Column="1"/>
                <TextBlock Grid.Row="1" Text="测试气压上限 / kPa"/><TextBox x:Name="MaximumPressure" Grid.Row="1" Grid.Column="1"/>
                <TextBlock Grid.Row="2" Text="充气时间 / s"/><TextBox x:Name="Fill" Grid.Row="2" Grid.Column="1"/>
                <TextBlock Grid.Row="3" Text="平衡时间 / s"/><TextBox x:Name="Balance" Grid.Row="3" Grid.Column="1"/>
                <TextBlock Grid.Row="4" Text="测试时间 / s"/><TextBox x:Name="Test" Grid.Row="4" Grid.Column="1"/>
                <TextBlock Grid.Row="5" Text="泄气时间 / s"/><TextBox x:Name="Exhaust" Grid.Row="5" Grid.Column="1"/>
                <TextBlock Grid.Row="6" Text="泄漏压降上限 / Pa"/><TextBox x:Name="MaximumLeak" Grid.Row="6" Grid.Column="1"/>
                <TextBlock Grid.Row="7" Text="设备完成结果码" ToolTip="留空则不提前结束"/><TextBox x:Name="TerminalResultCodes" Grid.Row="7" Grid.Column="1" ToolTip="例如：1,2。留空时只按工艺时间加安全余量结束。"/>
                <TextBlock Grid.Row="8" Text="连续确认次数"/><TextBox x:Name="TerminalResultStablePolls" Grid.Row="8" Grid.Column="1"/>
                <TextBlock Grid.Row="9" Text="等待面板 Start / s"/><TextBox x:Name="ManualStartWaitTimeout" Grid.Row="9" Grid.Column="1"/>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12"><TextBlock Text="产品名称、统计模式、扫码模式以及测试记录/日志路径，请在主界面的“基础配置”中设置。" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="设备由操作员在面板按 Start 启动；本页保存将写入并逐项回读核对气密仪工艺参数，请先连接气密仪。" Foreground="#92400E" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="Error" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SaveButton" Content="保存并同步气密仪" Click="Save_Click" Margin="0,0,10,0" Padding="16,6"/><Button x:Name="CancelButton" Content="取消" IsCancel="True" Padding="16,6"/></StackPanel>
        <Border x:Name="SyncOverlay" Grid.RowSpan="4" Background="#B3FFFFFF" Visibility="Collapsed" Panel.ZIndex="10"><Border Width="390" Padding="26" Background="White" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="正在同步气密仪配置" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><ProgressBar IsIndeterminate="True" Height="12" Margin="0,18,0,14" Foreground="#0EA5E9"/><TextBlock Text="正在同步 CH1、CH2 各 7 项参数，并逐项回读核对。请勿关闭窗口或断开气密仪。" TextWrapping="Wrap" TextAlignment="Center" Foreground="#475569"/></StackPanel></Border></Border>
    </Grid>
</Window>