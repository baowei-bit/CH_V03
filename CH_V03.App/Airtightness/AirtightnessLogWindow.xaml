<Window x:Class="CH_V03.App.Views.AirtightnessLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="气密检测 · 运行日志" Width="1060" Height="640" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#EAF7FF" FontFamily="Microsoft YaHei UI"
        Icon="/CeHao;component/Assets/company-icon.png" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="气密运行日志" FontSize="23" FontWeight="SemiBold" Foreground="#164E63"/>
            <TextBlock Text="本次运行最新 1000 条 · 最新日志在上方 · 实时更新" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="8">
            <ListBox ItemsSource="{Binding Logs}" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6,7"/></Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#164E63" FontSize="13" FontFamily="Consolas, Microsoft YaHei UI"/></DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="#64748B" TextWrapping="Wrap">
            <Run Text="日志按日期保存于："/><Run Text="{Binding LogDirectory, Mode=OneWay}"/>
        </TextBlock>
    </Grid>
</Window>
