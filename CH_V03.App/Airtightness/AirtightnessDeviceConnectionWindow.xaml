<Window x:Class="CH_V03.App.Views.AirtightnessDeviceConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="气密设备连接" Width="1120" Height="700" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#EAF7FF" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Height" Value="27"/><Setter Property="Padding" Value="7,2"/><Setter Property="Margin" Value="0,1"/><Setter Property="BorderBrush" Value="#7DD3FC"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="27"/><Setter Property="Padding" Value="6,1"/><Setter Property="Margin" Value="0,1"/></Style>
        <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#164E63"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#475569"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,2,7,2"/></Style>
        <Style x:Key="DeviceCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#7DD3FC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="4"/></Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <UniformGrid Grid.Row="0" Columns="3">
            <Border Style="{StaticResource DeviceCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="扫码枪" Style="{StaticResource Title}"/>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="通讯方式" Style="{StaticResource Label}"/><ComboBox Grid.Column="1" x:Name="ScannerType" SelectionChanged="ScannerType_SelectionChanged"><ComboBoxItem Content="USB POS HID"/><ComboBoxItem Content="串口"/><ComboBoxItem Content="TCP 客户端"/><ComboBoxItem Content="TCP 服务端"/><ComboBoxItem Content="禁用"/></ComboBox></Grid>
                    <StackPanel Grid.Row="2" x:Name="ScannerSerialFields">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="串口号" Style="{StaticResource Label}"/><ComboBox Grid.Column="1" x:Name="ScannerPort" IsEditable="True"/></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="波特率" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="ScannerBaud"/></Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="2" x:Name="ScannerTcpFields">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="TCP 地址" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="ScannerIp"/></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="TCP 端口" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="ScannerTcpPort"/></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="超时 / ms" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="ScannerConnectionTimeout"/></Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3" x:Name="ScannerCommandFields" Margin="0,5,0,0">
                        <CheckBox x:Name="ScannerTriggerEnabled" Content="连接后自动发送扫码指令" Margin="0,1,0,2"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="触发指令" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="ScannerTriggerCommand"/></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="停止指令" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="ScannerStopCommand"/></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="等待 / 秒" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="ScannerWaitTimeout"/></Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Margin="0,8,0,0">
                        <TextBlock x:Name="ScannerConnectionState" Text="扫码枪未连接" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal"><Button x:Name="ScannerConnectionButton" Content="连接扫码枪" Click="ToggleScanner_Click" Padding="9,3" Margin="0,0,6,0"/><Button Content="测试连通" Click="TestScanner_Click" Padding="9,3"/></StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource DeviceCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="气密泄漏检测仪" Style="{StaticResource Title}"/>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="串口号" Style="{StaticResource Label}"/><ComboBox Grid.Column="1" x:Name="InstrumentPort" IsEditable="True"/></Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="波特率" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="InstrumentBaud"/></Grid>
                    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Modbus 站号" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="InstrumentAddress"/></Grid>
                    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="超时 / ms" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="InstrumentTimeout"/></Grid>
                    <StackPanel Grid.Row="6" Margin="0,8,0,0"><TextBlock x:Name="InstrumentConnectionState" Text="气密仪未连接" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><StackPanel Orientation="Horizontal"><Button x:Name="InstrumentConnectionButton" Content="连接气密仪" Click="ToggleInstrument_Click" Padding="9,3" Margin="0,0,6,0"/><Button Content="测试连通" Click="TestInstrument_Click" Padding="9,3"/></StackPanel></StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource DeviceCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="双通道下位机" Style="{StaticResource Title}"/>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="串口号" Style="{StaticResource Label}"/><ComboBox Grid.Column="1" x:Name="MotionPort" IsEditable="True"/></Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="波特率" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="MotionBaud"/></Grid>
                    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Modbus 站号" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="MotionAddress"/></Grid>
                    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="超时 / ms" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="MotionTimeout"/></Grid>
                    <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CH1 输出 Y" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="MotionChannel1Output"/></Grid>
                    <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CH2 输出 Y" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="MotionChannel2Output"/></Grid>
                    <Grid Grid.Row="7"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="启动输入 X" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="MotionStartInput"/></Grid>
                    <Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Y 保持 / 秒" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="MotionOutputReleaseDelay"/></Grid>
                    <StackPanel Grid.Row="9" Margin="0,6,0,0"><TextBlock x:Name="MotionConnectionState" Text="下位机未连接" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><StackPanel Orientation="Horizontal"><Button x:Name="MotionConnectionButton" Content="连接下位机" Click="ToggleMotion_Click" Padding="9,3" Margin="0,0,6,0"/><Button Content="测试连通" Click="TestMotion_Click" Padding="9,3"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button Content="CH1 开启" Click="Channel1On_Click" Padding="7,3" Margin="0,0,4,0"/><Button Content="CH1 关闭" Click="Channel1Off_Click" Padding="7,3" Margin="0,0,6,0"/><Button Content="CH2 开启" Click="Channel2On_Click" Padding="7,3" Margin="0,0,4,0"/><Button Content="CH2 关闭" Click="Channel2Off_Click" Padding="7,3"/></StackPanel></StackPanel>
                </Grid>
            </Border>
        </UniformGrid>
        <StackPanel Grid.Row="1" Margin="4,5,4,0"><TextBlock Text="三个设备均可单独“测试连通”；测试只验证通讯，不执行扫码、配方写入或现场继电器动作。下位机必须使用不同于气密仪的独立串口。" Foreground="#92400E" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="Error" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="保存连接设置" Click="Save_Click" Padding="14,5" Margin="0,0,8,0"/><Button Content="取消" IsCancel="True" Padding="14,5"/></StackPanel>
    </Grid>
</Window>