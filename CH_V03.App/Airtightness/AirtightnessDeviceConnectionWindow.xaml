<Window x:Class="CH_V03.App.Views.AirtightnessDeviceConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="气密设备连接" Width="860" Height="820" MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="#EAF7FF" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Height" Value="31"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="0,3"/><Setter Property="BorderBrush" Value="#7DD3FC"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="31"/><Setter Property="Padding" Value="6,2"/><Setter Property="Margin" Value="0,3"/></Style>
        <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#164E63"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#475569"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存连接设置" Click="Save_Click" Padding="16,6" Margin="0,0,10,0"/>
            <Button Content="取消" IsCancel="True" Padding="16,6"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="气密仪按厂家 BYZ 协议使用 Modbus RTU：9600、8N1、默认站号 01。连接后会读取当前压力寄存器验证通讯。" Foreground="#92400E" TextWrapping="Wrap"/>
            <TextBlock x:Name="Error" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <UniformGrid Columns="2">
            <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="扫码枪" Style="{StaticResource Title}"/>
                    <TextBlock Text="通讯方式" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="ScannerType" SelectionChanged="ScannerType_SelectionChanged">
                        <ComboBoxItem Content="USB POS HID"/>
                        <ComboBoxItem Content="串口"/>
                        <ComboBoxItem Content="TCP 客户端"/>
                        <ComboBoxItem Content="TCP 服务端"/>
                        <ComboBoxItem Content="禁用"/>
                    </ComboBox>
                    <StackPanel x:Name="ScannerSerialFields">
                        <TextBlock Text="串口号" Style="{StaticResource Label}" Margin="0,12,0,3"/>
                        <ComboBox x:Name="ScannerPort" IsEditable="True"/>
                        <TextBlock Text="波特率" Style="{StaticResource Label}" Margin="0,12,0,3"/>
                        <TextBox x:Name="ScannerBaud"/>
                    </StackPanel>
                    <StackPanel x:Name="ScannerTcpFields">
                        <TextBlock Text="TCP 地址（服务端可填 0.0.0.0）" Style="{StaticResource Label}" Margin="0,12,0,3"/>
                        <TextBox x:Name="ScannerIp"/>
                        <TextBlock Text="TCP 端口" Style="{StaticResource Label}" Margin="0,12,0,3"/>
                        <TextBox x:Name="ScannerTcpPort"/>
                        <TextBlock Text="连接超时 / ms" Style="{StaticResource Label}" Margin="0,8,0,3"/>
                        <TextBox x:Name="ScannerConnectionTimeout"/>
                    </StackPanel>
                    <StackPanel x:Name="ScannerCommandFields">
                        <CheckBox x:Name="ScannerTriggerEnabled" Content="主界面点击“开始测试”时自动发送扫码指令" Margin="0,12,0,4"/>
                        <TextBlock Text="扫码触发指令（支持 \r、\n、\t）" Style="{StaticResource Label}"/>
                        <TextBox x:Name="ScannerTriggerCommand"/>
                        <TextBlock Text="扫码停止指令（不需要可留空）" Style="{StaticResource Label}" Margin="0,8,0,3"/>
                        <TextBox x:Name="ScannerStopCommand"/>
                        <TextBlock Text="双通道扫码等待超时 / 秒" Style="{StaticResource Label}" Margin="0,8,0,3"/>
                        <TextBox x:Name="ScannerWaitTimeout"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock x:Name="ScannerConnectionState" Text="扫码枪未连接" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,10,0"/><Button x:Name="ScannerTestButton" Content="连接扫码枪" Click="ToggleScanner_Click" Padding="12,4"/></StackPanel>
                    <TextBlock Text="自动扫码会先触发并接收 CH1，再触发并接收 CH2。USB HID 设备只能等待操作员按实体按键，不能接收软件触发命令。" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="气密泄漏检测仪" Style="{StaticResource Title}"/>
                    <TextBlock Text="串口号" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="InstrumentPort" IsEditable="True"/>
                    <TextBlock Text="波特率" Style="{StaticResource Label}" Margin="0,12,0,3"/>
                    <TextBox x:Name="InstrumentBaud"/>
                    <TextBlock Text="Modbus 站号" Style="{StaticResource Label}" Margin="0,12,0,3"/>
                    <TextBox x:Name="InstrumentAddress"/>
                    <TextBlock Text="通讯超时 / ms" Style="{StaticResource Label}" Margin="0,12,0,3"/>
                    <TextBox x:Name="InstrumentTimeout"/>
                    <TextBlock Text="保存测试参数时：上位机逐项写入寄存器 101–104、106、108、112，随后读取并核对。" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>
        </ScrollViewer>
        <Border Grid.Row="1" Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="双通道 I/O 模块" FontSize="16" FontWeight="SemiBold" Foreground="#164E63"/><TextBlock x:Name="MotionConnectionState" Text="I/O 模块未连接" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><Button x:Name="MotionConnectionButton" Content="连接 I/O 模块" Click="ToggleMotion_Click" Padding="12,5" Margin="0,0,10,0"/><Button Content="CH1 开启" Click="Channel1On_Click" Padding="12,5" Margin="0,0,6,0"/><Button Content="CH1 关闭" Click="Channel1Off_Click" Padding="12,5" Margin="0,0,12,0"/><Button Content="CH2 开启" Click="Channel2On_Click" Padding="12,5" Margin="0,0,6,0"/><Button Content="CH2 关闭" Click="Channel2Off_Click" Padding="12,5"/></StackPanel>
                <Button Grid.Column="2" Content="双通道动作设置" Click="OpenMotionSettings_Click" Padding="12,5" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
