<Window x:Class="CH_V03.App.Views.AirtightnessMotionControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="双通道下位机设置" Width="720" Height="590" MinWidth="650" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#EAF7FF" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Height" Value="31"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="0,3"/><Setter Property="BorderBrush" Value="#7DD3FC"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#475569"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
        <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#7DD3FC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/></Style>
    </Window.Resources>
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存下位机设置" Click="Save_Click" Padding="16,6" Margin="0,0,10,0"/>
            <Button Content="关闭" IsCancel="True" Padding="16,6"/>
        </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock Text="安全规则：默认不允许下位机输出。确认现场接线、急停和限位保护正常后，才勾选“允许上位机控制下位机继电器”。手动测试可单独选择跳过继电器；自动扫码生产流程仍按继电器安全逻辑执行。下位机需使用不同于气密仪的独立串口。" Foreground="#92400E" TextWrapping="Wrap"/>
            <TextBlock x:Name="Error" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel>
            <DockPanel Margin="0,0,0,12"><TextBlock Text="双通道下位机控制" FontSize="19" FontWeight="SemiBold" Foreground="#164E63"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="ConnectionState" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#64748B"/><Button x:Name="ConnectionButton" Content="连接下位机" Click="ToggleConnection_Click" Padding="12,5"/></StackPanel></DockPanel>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="串口号" Style="{StaticResource Label}"/><TextBox x:Name="Port"/></StackPanel>
                    <StackPanel Margin="0,0,10,0" Grid.Column="1"><TextBlock Text="波特率" Style="{StaticResource Label}"/><TextBox x:Name="Baud"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Modbus 站号" Style="{StaticResource Label}"/><TextBox x:Name="Address"/></StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="CH1 对应输出（Y）" Style="{StaticResource Label}"/><TextBox x:Name="Channel1Output"/></StackPanel>
                    <StackPanel Margin="0,0,10,0" Grid.Column="1"><TextBlock Text="CH2 对应输出（Y）" Style="{StaticResource Label}"/><TextBox x:Name="Channel2Output"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="启动输入（X）" Style="{StaticResource Label}"/><TextBox x:Name="StartInput"/></StackPanel>
                </Grid>
            </Border>
            <StackPanel Margin="4,0,0,14"><TextBlock Text="通讯超时 / ms" Style="{StaticResource Label}"/><TextBox x:Name="Timeout" Width="180" HorizontalAlignment="Left"/><TextBlock Text="测试结束后 Y 保持 / s" Style="{StaticResource Label}" Margin="0,8,0,0"/><TextBox x:Name="OutputReleaseDelay" Width="180" HorizontalAlignment="Left" ToolTip="收到双通道最终测试结果后，再等待多久断开 Y1、Y2；默认 2 秒。"/><CheckBox x:Name="Enabled" Content="允许上位机控制下位机 X / Y（未勾选时不能发送继电器命令）" Foreground="#164E63" Margin="0,8,0,0"/><CheckBox x:Name="SkipRelayControlForManualTest" Content="手动测试跳过继电器控制，等待仪器面板 Start（仅手动/不扫码模式）" Foreground="#B45309" Margin="0,8,0,0"/><CheckBox x:Name="AutoOpenAfterBarcode" Content="保留兼容项：条码齐全后进入 X 输入待机，不会提前闭合 Y1 / Y2" Foreground="#164E63" Margin="0,8,0,0"/></StackPanel>
            <Border Style="{StaticResource Panel}"><UniformGrid Columns="2">
                <StackPanel Margin="0,0,12,0"><TextBlock Text="CH1 下位机输出" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="开启 CH1" Click="Channel1On_Click" Padding="14,5" Margin="0,0,8,0"/><Button Content="关闭 CH1" Click="Channel1Off_Click" Padding="14,5"/></StackPanel></StackPanel>
                <StackPanel><TextBlock Text="CH2 下位机输出" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="开启 CH2" Click="Channel2On_Click" Padding="14,5" Margin="0,0,8,0"/><Button Content="关闭 CH2" Click="Channel2Off_Click" Padding="14,5"/></StackPanel></StackPanel>
            </UniformGrid></Border>
        </StackPanel>
    </DockPanel>
</Window>
