<Window x:Class="CH_V03.App.Views.AirtightnessBasicConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="气密基础配置" Width="800" Height="680" MinWidth="650" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#EAF7FF" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#164E63"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,4"/><Setter Property="BorderBrush" Value="#7DD3FC"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#475569"/><Setter Property="Margin" Value="0,8,0,3"/></Style>
        <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#7DD3FC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Text="气密基础配置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="产品、统计、扫码、保存路径和下位机控制方式。保存仅更新上位机本地设置，不向气密仪下发参数。" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="产品名称"/><TextBox x:Name="Product" Grid.Column="1"/>
                        <TextBlock Grid.Row="1" Text="统计模式"/><ComboBox x:Name="CountingMode" Grid.Row="1" Grid.Column="1" Margin="0,6" Padding="6"><ComboBoxItem Content="两个产品：每个通道独立计数"/><ComboBoxItem Content="一个产品：两通道均合格才 PASS"/></ComboBox>
                        <TextBlock Grid.Row="2" Text="扫码模式"/><ComboBox x:Name="ScanMode" Grid.Row="2" Grid.Column="1" Margin="0,6" Padding="6"><ComboBoxItem Content="手动扫码：CH1 后自动切换 CH2"/><ComboBoxItem Content="自动扫码：扫码枪按 CH1、CH2 顺序接收"/><ComboBoxItem Content="不扫码：不要求条码"/></ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="下位机继电器控制方式" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <RadioButton x:Name="RelayControlEnabled" GroupName="RelayMode" Content="允许上位机控制下位机继电器" Foreground="#164E63" Margin="0,4"/>
                        <TextBlock Text="条码/下位机启动条件满足后，按配置控制 CH1、CH2 输出。" Foreground="#64748B" FontSize="12" Margin="25,0,0,6" TextWrapping="Wrap"/>
                        <RadioButton x:Name="SkipRelayControl" GroupName="RelayMode" Content="手动测试跳过下位机控制" Foreground="#B45309" Margin="0,4"/>
                        <TextBlock Text="不发送继电器输出，操作员直接在气密仪面板按 Start；该方式下自动扫码也不会强制控制下位机。" Foreground="#64748B" FontSize="12" Margin="25,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="测试记录保存路径"/><DockPanel Grid.Column="1"><Button DockPanel.Dock="Right" Content="浏览" Click="SelectRecordsDirectory_Click" Padding="12,2" Margin="8,4,0,4" Background="#F0F9FF" Foreground="#0369A1" BorderBrush="#7DD3FC"/><TextBox x:Name="RecordsDirectory" ToolTip="选择测试记录保存文件夹"/></DockPanel>
                        <TextBlock Grid.Row="1" Text="日志保存路径"/><DockPanel Grid.Row="1" Grid.Column="1"><Button DockPanel.Dock="Right" Content="浏览" Click="SelectLogDirectory_Click" Padding="12,2" Margin="8,4,0,4" Background="#F0F9FF" Foreground="#0369A1" BorderBrush="#7DD3FC"/><TextBox x:Name="LogDirectory" ToolTip="选择运行日志保存文件夹"/></DockPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12"><TextBlock Text="路径修改后立即读取新目录中的测试记录；旧目录文件会保留，不自动搬移。" TextWrapping="Wrap"/><TextBlock x:Name="Error" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="保存基础配置" Click="Save_Click" Margin="0,0,10,0" Padding="16,6"/><Button Content="取消" IsCancel="True" Padding="16,6"/></StackPanel>
    </Grid>
</Window>