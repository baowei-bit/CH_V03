<Window x:Class="CH_V03.App.Views.KunshanJiaLianYiUserConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户设置" Width="860" Height="590" WindowStartupLocation="CenterOwner" Background="#EAF7FF">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="8,3" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,5" /><Setter Property="Foreground" Value="#52606D" /></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#7DD3FC" BorderThickness="1,1,0,0" Padding="14"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="保存" Command="{Binding SaveCommand}" Width="96" Height="34" Margin="0,0,10,0" /><Button Content="退出" Command="{Binding CancelCommand}" Width="96" Height="34" /></StackPanel></Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
            <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="用户操作设置" /><UniformGrid Columns="2">
                <StackPanel Margin="0,0,14,12"><RadioButton Content="自动扫码" GroupName="ScanMode" IsChecked="{Binding IsAutoScanMode}" /><RadioButton Content="手动扫码" GroupName="ScanMode" IsChecked="{Binding IsManualScanMode}" Margin="0,10,0,0" /><CheckBox Content="扫码先行（扫码成功后等待下位机 DM）" IsChecked="{Binding Configuration.ScanAheadEnabled}" Margin="24,6,0,0" IsEnabled="{Binding IsManualScanMode}" /><RadioButton Content="不扫码" GroupName="ScanMode" IsChecked="{Binding IsNoScanMode}" Margin="0,10,0,0" /></StackPanel>
                <StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="连续 NG 报警数量" /><TextBox Text="{Binding Configuration.ConsecutiveNgAlarmCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" /><TextBlock Style="{StaticResource Label}" Text="登录工号" /><TextBox Text="{Binding Configuration.LoginJobNo, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            </UniformGrid></StackPanel></Border>
            <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="特殊配置" />
                <TextBlock Text="生产模式和调试模式请在基础资料页面切换。生产模式按下列良率规则控制上传。" Foreground="#52606D" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="生产模式 MES 上传良率阈值(%)：" VerticalAlignment="Center" /><TextBox Width="110" Text="{Binding Configuration.Jly.YieldUploadThreshold, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="（良率小于或等于该值时不上传）" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#52606D" /></StackPanel>
            </StackPanel></Border>
        </StackPanel></ScrollViewer>
    </DockPanel>
</Window>
