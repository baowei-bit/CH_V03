<Window x:Class="CH_V03.App.Views.PluginConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="插件配置"
        Width="940"
        Height="620"
        MinWidth="820"
        MinHeight="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#EAF7FF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="#52606D" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FolderPickerButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="Background" Value="#F0F9FF" />
            <Setter Property="BorderBrush" Value="#7DD3FC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0369A1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FolderPickerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FolderPickerBorder" Property="Background" Value="#E0F2FE" />
                                <Setter TargetName="FolderPickerBorder" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FolderPickerBorder" Property="Background" Value="#BAE6FD" />
                                <Setter TargetName="FolderPickerBorder" Property="BorderBrush" Value="#0EA5E9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter TargetName="FolderPickerBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="FolderPickerBorder" Property="BorderBrush" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="MesFieldPanel">
            <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="MesPluginFieldTemplate">
            <StackPanel Margin="0,0,14,12">
                <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCheckbox}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHongXinMesMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Key}" Value="CraftMappings">
                                        <Setter Property="Height" Value="86" />
                                        <Setter Property="AcceptsReturn" Value="True" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Grid.Column="1" Content="浏览" Command="{Binding BrowseDirectoryCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FolderPickerButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <CheckBox Content="&#x542F;&#x7528;" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCheckbox}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHongXinMesMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <RadioButton Content="设备产能上传" GroupName="HongXinMesUploadMode" IsChecked="{Binding IsCapacityUploadMode, Mode=TwoWay}" Margin="0,0,18,0" />
                    <RadioButton Content="设备单品过站" GroupName="HongXinMesUploadMode" IsChecked="{Binding IsSinglePieceStationMode, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Foreground="#94A3B8" FontSize="11" Text="{Binding HelpText}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#7DD3FC" BorderThickness="1,1,0,0" Padding="14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Command="{Binding SaveCommand}" Width="96" Height="34" Margin="0,0,10,0" />
                <Button Content="退出" Command="{Binding CancelCommand}" Width="96" Height="34" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="MES 插件" />
                        <TextBlock Foreground="#64748B" Text="MES 基础设置和所选 MES 插件的专有参数统一在此维护。" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="当前插件" Margin="0,0,12,10" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding MesPluginChoices}"
                                      DisplayMemberPath="Description"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedMesPluginId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#64748B" TextWrapping="Wrap"
                                       Text="嘉联益 CareerRule MES 会复用默认 MES 基础资料；其他客户 MES 仅维护各自的专有参数。" />
                        </Grid>
                        <Border Background="#F8FCFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,16,0,0"
                                Visibility="{Binding ShouldShowDefaultMesSettings, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="默认 MES 基础资料" FontWeight="SemiBold" Foreground="#075985" Margin="0,0,0,10" />
                                <UniformGrid Columns="3">
                            <CheckBox Content="启用 MES" IsChecked="{Binding Configuration.Mes.Enabled}" Margin="0,4,14,12" />
                            <CheckBox Content="允许离线缓存" IsChecked="{Binding Configuration.Mes.AllowOfflineCache}" Margin="0,4,14,12" />
                            <CheckBox Content="在线模式默认开启" IsChecked="{Binding Configuration.Mes.OnlineMode}" Margin="0,4,0,12" />
                            <StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="站位" /><TextBox Text="{Binding Configuration.Identity.StationNo, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="MES 地址" /><TextBox Text="{Binding Configuration.Mes.BaseUrl, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,0,12"><TextBlock Style="{StaticResource Label}" Text="工号/账号" /><TextBox Text="{Binding Configuration.Mes.UserNo, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="密码" /><TextBox Text="{Binding Configuration.Mes.Password, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="箱号" /><TextBox Text="{Binding Configuration.Mes.PackNo, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,0,12"><TextBlock Style="{StaticResource Label}" Text="治具" /><TextBox Text="{Binding Configuration.Mes.Tooling, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="工单" /><TextBox Text="{Binding Configuration.Mes.ProdNo, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <CheckBox x:Name="YieldControlCheckBox" Content="启用良率控制上传" IsChecked="{Binding Configuration.Mes.EnableYieldControlUploadToMes}" Margin="0,4,14,12" />
                            <StackPanel Margin="0,0,0,12" IsEnabled="{Binding IsChecked, ElementName=YieldControlCheckBox}"><TextBlock Style="{StaticResource Label}" Text="上传阈值(%)" /><TextBox Text="{Binding Configuration.Mes.YieldControlThreshold, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding MesPluginFields}"
                                      Margin="0,16,0,0"
                                      Visibility="{Binding HasOtherMesPluginFields, Converter={StaticResource BoolToVisibility}}"
                                      ItemsPanel="{StaticResource MesFieldPanel}"
                                      ItemTemplate="{StaticResource MesPluginFieldTemplate}" />

                        <ItemsControl Margin="0,12,0,0" Visibility="{Binding IsJingWangMesPlugin, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding JingWangLogFields}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" />
                        <TabControl Margin="0,16,0,0" MinHeight="270"
                                    Visibility="{Binding IsJingWangMesPlugin, Converter={StaticResource BoolToVisibility}}">
                            <TabItem Header="数据库">
                                <StackPanel Margin="12">
                                    <ItemsControl ItemsSource="{Binding JingWangDbFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" />
                                    <TextBlock Text="数据库密码" FontWeight="SemiBold" />
                                    <PasswordBox x:Name="JingWangDbPasswordBox" Width="280" HorizontalAlignment="Left" Margin="0,4,0,10" PasswordChanged="JingWangDbPasswordBox_PasswordChanged" />
                                    <Button Content="测试数据库连接" Command="{Binding TestJingWangDatabaseCommand}" Width="150" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding JingWangConnectionMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="工艺质量"><ItemsControl Margin="12" ItemsSource="{Binding JingWangCraftFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" /></TabItem>
                            <TabItem Header="设备读码"><ItemsControl Margin="12" ItemsSource="{Binding JingWangScanFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" /></TabItem>
                            <TabItem Header="设备报警"><ItemsControl Margin="12" ItemsSource="{Binding JingWangAlarmFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" /></TabItem>
                            <TabItem Header="员工上下机">
                                <StackPanel Margin="12">
                                    <ItemsControl ItemsSource="{Binding JingWangEmployeeFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" />
                                    <TextBlock Text="上机许可通过后写入上机记录，切离线及正常退出时写入下机记录。" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="CSV 文件及关联">
                                <StackPanel Margin="12">
                                    <ItemsControl ItemsSource="{Binding JingWangCsvFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" />
                                    <TextBlock Text="S3 Secret Key" />
                                    <PasswordBox x:Name="JingWangS3SecretKeyBox" Width="280" HorizontalAlignment="Left" Margin="0,4,0,10" PasswordChanged="JingWangS3SecretKeyBox_PasswordChanged" />
                                    <TextBlock Text="CSV 上传成功后，IMGCONTENT 保存 S3 对象键并省略 .csv 后缀。" TextWrapping="Wrap" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="工治具上下机">
                                <StackPanel Margin="12">
                                    <ItemsControl ItemsSource="{Binding JingWangToolFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" />
                                    <WrapPanel>
                                        <Label Content="工治具条码"/><TextBox Width="210" Text="{Binding ToolBarcode, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="工治具上机" Command="{Binding ToolLoginCommand}" Margin="4"/>
                                        <Label Content="已使用寿命"/><TextBox Width="90" Text="{Binding ToolUsedLife, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="工治具下机" Command="{Binding ToolLogoutCommand}" Margin="4"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding JingWangConnectionMessage}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="过站复判与检测记录">
                                <StackPanel Margin="12">
                                    <ItemsControl ItemsSource="{Binding JingWangInspectionFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" />
                                    <ItemsControl ItemsSource="{Binding JingWangResultFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" />
                                    <ItemsControl ItemsSource="{Binding JingWangApiFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" />
                                    <TextBlock Text="扫码时校验过站，测试完成后写入检测记录、结果并调用复判接口。" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="待处理记录">
                                <StackPanel Margin="12">
                                    <TextBlock Text="先核对原始结果与工单，再选择记录执行补写；补过站与复判只在 MES 在线时执行。" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <DataGrid ItemsSource="{Binding JingWangPendingRecords}" SelectedItem="{Binding SelectedJingWangPendingRecord}"
                                              AutoGenerateColumns="False" IsReadOnly="True" Height="180">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt}" Width="140" />
                                            <DataGridTextColumn Header="条码" Binding="{Binding Barcode}" Width="180" />
                                            <DataGridTextColumn Header="工单" Binding="{Binding WorkOrder}" Width="130" />
                                            <DataGridTextColumn Header="批次" Binding="{Binding Lot}" Width="120" />
                                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="140" />
                                            <DataGridTextColumn Header="原始结论" Binding="{Binding Result}" Width="90" />
                                            <DataGridTextColumn Header="单片 CSV" Binding="{Binding CsvPath}" Width="200" />
                                            <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="刷新" Command="{Binding RefreshJingWangPendingCommand}" Width="70" Margin="0,0,8,0" />
                                        <Button Content="补写数据库" Command="{Binding RetryJingWangDatabaseCommand}" Width="110" Margin="0,0,8,0" />
                                        <Button Content="补过站与复判" Command="{Binding RetryJingWangApisCommand}" Width="130" Margin="0,0,8,0" />
                                        <Button Content="核对后归档" Command="{Binding ArchiveJingWangPendingCommand}" Width="100" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding JingWangConnectionMessage}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </TabItem>
                        </TabControl>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsHongXinMesPlugin, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="#F8FCFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="原 OA 系统" FontWeight="SemiBold" Foreground="#075985" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding OaMesPluginFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FCFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="公共 MES" FontWeight="SemiBold" Foreground="#075985" Margin="0,0,0,4" />
                                    <TextBlock Text="接口模式、流程单开工和终端认证参数" Foreground="#64748B" FontSize="11" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding CommonMesPluginFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FCFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="设备产能上传" FontWeight="SemiBold" Foreground="#075985" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding CapacityMesPluginFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FCFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="设备单品过站" FontWeight="SemiBold" Foreground="#075985" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding StationMesPluginFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FCFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="分类映射" FontWeight="SemiBold" Foreground="#075985" Margin="0,0,0,4" />
                                    <TextBlock Text="测试分类对应的 MES 特性代号和不良代号" Foreground="#64748B" FontSize="11" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding MappingMesPluginFields}" ItemsPanel="{StaticResource MesFieldPanel}" ItemTemplate="{StaticResource MesPluginFieldTemplate}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="导出器插件" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="当前导出器" Margin="0,0,12,10" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding ExportPluginChoices}"
                                      DisplayMemberPath="Description"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedExportPluginId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#64748B" TextWrapping="Wrap"
                                       Text="不选择客户导出器时使用默认导出：CSV、DCL、CsvMes。选择客户导出器后，测试完成时只执行该客户导出插件。" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ExportPluginFields}"
                                      Margin="0,16,0,0"
                                      Visibility="{Binding HasExportPluginFields, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,14,12">
                                        <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="96" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCheckbox}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                            </TextBox>
                                            <Button Grid.Column="1" Content="浏览" Command="{Binding BrowseDirectoryCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource FolderPickerButton}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <CheckBox Content="&#x542F;&#x7528;"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCheckbox}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <TextBlock Foreground="#94A3B8"
                                                   FontSize="11"
                                                   Text="{Binding HelpText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="#F8FCFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,8,0,0"
                                Visibility="{Binding IsDefaultExportSelected, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="默认导出设置" FontWeight="SemiBold" Foreground="#075985" Margin="0,0,0,4" />
                                <TextBlock Text="未选择客户导出器时，以下即为原“基础配置”的 CSV、DCL 与保存规则。" Foreground="#64748B" FontSize="11" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="1" Text="DCL/TXT 保存路径" Margin="0,0,12,12" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Configuration.Output.DclDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,12" /><Button Grid.Row="1" Grid.Column="2" Content="浏览" Style="{StaticResource FolderPickerButton}" Click="SelectDclDirectory_Click" Margin="0,0,0,12" />
                                    <TextBlock Grid.Row="2" Text="产品 CSV 保存路径" Margin="0,0,12,12" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Configuration.Output.CsvDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,12" /><Button Grid.Row="2" Grid.Column="2" Content="浏览" Style="{StaticResource FolderPickerButton}" Click="SelectCsvDirectory_Click" Margin="0,0,0,12" />
                                    <CheckBox Grid.Row="3" Grid.Column="1" Content="按测试结果生成 PASS/FAIL 文件夹" IsChecked="{Binding Configuration.Output.ClassifyCsvByResult}" Margin="0,0,0,12" />
                                    <CheckBox Grid.Row="4" Grid.Column="1" Content="启用扫码客户路径保存" IsChecked="{Binding Configuration.Output.CustomerPathSaveEnabled}" Margin="0,0,0,12" />
                                    <TextBlock Grid.Row="5" Text="客户路径保存根目录" Margin="0,0,12,12" VerticalAlignment="Center" /><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Configuration.Output.CustomerPathRootDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Configuration.Output.CustomerPathSaveEnabled}" Margin="0,0,8,12" /><Button Grid.Row="5" Grid.Column="2" Content="浏览" Style="{StaticResource FolderPickerButton}" Click="SelectCustomerPathRootDirectory_Click" IsEnabled="{Binding Configuration.Output.CustomerPathSaveEnabled}" Margin="0,0,0,12" />
                                    <CheckBox Grid.Row="6" Grid.Column="1" Content="启用每片单独 CSV" IsChecked="{Binding Configuration.Output.SinglePieceCsvEnabled}" Margin="0,0,0,12" />
                                    <TextBlock Grid.Row="7" Text="单片 CSV 保存路径" Margin="0,0,12,12" VerticalAlignment="Center" /><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Configuration.Output.SinglePieceCsvDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Configuration.Output.SinglePieceCsvEnabled}" Margin="0,0,8,12" /><Button Grid.Row="7" Grid.Column="2" Content="浏览" Style="{StaticResource FolderPickerButton}" Click="SelectSinglePieceCsvDirectory_Click" IsEnabled="{Binding Configuration.Output.SinglePieceCsvEnabled}" Margin="0,0,0,12" />
                                    <TextBlock Grid.Row="8" Text="单片 CSV 名称规则" Margin="0,0,12,0" VerticalAlignment="Center" /><StackPanel Grid.Row="8" Grid.Column="1"><TextBox Text="{Binding Configuration.Output.SinglePieceCsvFileName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Configuration.Output.SinglePieceCsvEnabled}" /><TextBlock Foreground="#94A3B8" FontSize="11" Text="可用变量：{Result}、{SN}、{Time}、{Name}，例如 {Result}_{SN}_{Time}.csv" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
