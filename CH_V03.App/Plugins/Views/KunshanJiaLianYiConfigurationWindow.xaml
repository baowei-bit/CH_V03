<Window x:Class="CH_V03.App.Views.KunshanJiaLianYiConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="昆山嘉联益配置" Width="980" Height="720" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#EAF7FF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBox"><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="8,3" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,5" /><Setter Property="Foreground" Value="#52606D" /></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#7DD3FC" BorderThickness="1,1,0,0" Padding="14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="保存" Command="{Binding SaveCommand}" Width="96" Height="34" Margin="0,0,10,0" /><Button Content="退出" Command="{Binding CancelCommand}" Width="96" Height="34" /></StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
            <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="MES 与导出插件" />
                    <TextBlock Text="当前 MES：嘉联益 CareerRule MES（JiaLianYi.CareerRule）" FontWeight="SemiBold" />
                    <TextBlock Text="当前导出器：嘉联益 CSV/DCL 导出（JiaLianYi.Export）" Foreground="#52606D" Margin="0,5,0,14" />
                    <TextBlock Text="两项插件已由昆山嘉联益模式锁定，不能修改。相同资料只需填写一次，会同时用于 MES 与导出。" Foreground="#0369A1" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <ItemsControl ItemsSource="{Binding SharedFields}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="{Binding Label}" /><TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="导出设置" /><ItemsControl ItemsSource="{Binding ExportFields}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource Label}" Text="{Binding Label}" /><TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><TextBox.Style><Style TargetType="TextBox"><Style.Triggers><DataTrigger Binding="{Binding IsCheckbox}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><CheckBox Content="启用" IsChecked="{Binding IsChecked, Mode=TwoWay}" Visibility="{Binding IsCheckbox, Converter={StaticResource BoolToVisibility}}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            </Border>
        </StackPanel></ScrollViewer>
    </DockPanel>
</Window>
