<Window x:Class="BW_V01.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="820"
        Width="1260"
        MinHeight="720"
        MinWidth="1120"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/company-icon.png"
        Background="#BFD7EA">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#8CA8BA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ValueBox" TargetType="TextBlock">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ValueInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="TinyState" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#94A3B8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid>
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" Background="#D1D5DB">
            <MenuItem Header="系统管理">
                <MenuItem Header="基础配置" Command="{Binding OpenBasicConfigurationCommand}" IsEnabled="{Binding CanManageSystem}" />
                <MenuItem Header="通讯设置" Command="{Binding OpenCommunicationConfigurationCommand}" IsEnabled="{Binding CanManageSystem}" />
                <MenuItem Header="MES 设置" Command="{Binding OpenMesConfigurationCommand}" IsEnabled="{Binding CanManageSystem}" />
                <MenuItem Header="测试项配置" Command="{Binding OpenTestItemConfigurationCommand}" IsEnabled="{Binding CanManageSystem}" />
                <MenuItem Header="导入客户方案" Command="{Binding ImportProjectProfileCommand}" IsEnabled="{Binding CanImportProjectProfile}" />
                <MenuItem Header="保存配置" Command="{Binding SaveConfigurationCommand}" />
            </MenuItem>
            <MenuItem Header="用户操作">
                <MenuItem Header="用户配置" Command="{Binding OpenUserConfigurationCommand}" IsEnabled="{Binding CanManageUsers}" />
            </MenuItem>
            <MenuItem Header="数据分析" Command="{Binding OpenDataAnalysisCommand}" IsEnabled="{Binding CanViewAnalysis}" />
            <MenuItem Header="软件帮助" Command="{Binding HelpCommand}" />
            <MenuItem Header="切换登录" Command="{Binding SwitchLoginCommand}" />
        </Menu>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#6B7280" BorderThickness="0,0,0,1" Padding="0,8">
            <TextBlock Text="{Binding HeaderTitle}" FontSize="30" Foreground="#1D4ED8" HorizontalAlignment="Center" />
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#F8FAFC">
            <StatusBarItem Content="{Binding StatusMessage}" />
            <Separator />
            <StatusBarItem Content="{Binding LoginDisplay}" />
        </StatusBar>

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="320" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46*" />
                    <ColumnDefinition Width="24*" />
                    <ColumnDefinition Width="30*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="SN:" FontSize="18" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueBox}" Text="{Binding CurrentBarcode}" FontSize="18" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="FSN:" FontSize="18" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueBox}" Text="{Binding LastFailItem}" FontSize="18" Margin="0,12,0,0" />

                        <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="连接状态" Margin="0,16,0,0" Padding="12">
                            <UniformGrid Columns="3">
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                    <Border Style="{StaticResource TinyState}" />
                                    <StackPanel>
                                        <TextBlock Text="扫码枪" />
                                        <TextBlock Text="{Binding ScannerState}" Foreground="#52606D" />
                                        <TextBlock Text="{Binding ScannerSummary}" Foreground="#52606D" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                    <Border Style="{StaticResource TinyState}" />
                                    <StackPanel>
                                        <TextBlock Text="下位机" />
                                        <TextBlock Text="{Binding LowerMachineState}" Foreground="#52606D" />
                                        <TextBlock Text="{Binding LowerMachineSummary}" Foreground="#52606D" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource TinyState}" />
                                    <StackPanel>
                                        <TextBlock Text="MES" />
                                        <TextBlock Text="{Binding MesState}" Foreground="#52606D" />
                                        <TextBlock Text="{Binding MesPlugin}" Foreground="#52606D" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>
                        </GroupBox>

                        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Button Content="连接设备" Command="{Binding ConnectDevicesCommand}" Height="34" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Button Content="断开设备" Command="{Binding DisconnectDevicesCommand}" Height="34" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <Button Content="{Binding OnlineModeText}" Command="{Binding ToggleOnlineModeCommand}" Height="34" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="测试状态" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TestState}" FontSize="52" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TestTime}" FontSize="22" Foreground="#374151" HorizontalAlignment="Center" Margin="0,16,0,0" />
                            <UniformGrid Columns="2" Margin="0,24,0,0">
                                <Button Content="初始化" Command="{Binding InitializeFlowCommand}" Height="34" Margin="0,0,6,8" />
                                <Button Content="模拟扫码" Command="{Binding SimulateScanCommand}" Height="34" Margin="6,0,0,8" />
                                <Button Content="模拟PASS" Command="{Binding SimulatePassCommand}" Height="34" Margin="0,0,6,0" />
                                <Button Content="模拟FAIL" Command="{Binding SimulateFailCommand}" Height="34" Margin="6,0,0,0" />
                            </UniformGrid>
                            <Button Content="清空良率" Command="{Binding ClearYieldCommand}" Width="120" Height="34" Margin="0,16,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="MES / 生产信息" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="站位" Margin="0,0,10,8" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueInput}" Text="{Binding StationNo}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="工单" Margin="0,0,10,8" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueInput}" Text="{Binding MesProdNo}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="总数" Margin="0,0,10,8" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueBox}" Text="{Binding TotalCount}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Pass / Fail" Margin="0,0,10,8" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueBox}" Text="{Binding PassFailText}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="良率" Margin="0,0,10,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueBox}" Text="{Binding YieldRateText}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="64*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="运行日志" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="13" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="测试项目" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding TestItems}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="All">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result}" Value="OK">
                                            <Setter Property="Background" Value="#DCFCE7" />
                                            <Setter Property="Foreground" Value="#166534" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result}" Value="NG">
                                            <Setter Property="Background" Value="#FEE2E2" />
                                            <Setter Property="Foreground" Value="#991B1B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="60" IsReadOnly="True" />
                                <DataGridTextColumn Header="测试项目" Binding="{Binding ItemName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="上限" Binding="{Binding UpperLimit, UpdateSourceTrigger=LostFocus}" Width="100" />
                                <DataGridTextColumn Header="下限" Binding="{Binding LowerLimit, UpdateSourceTrigger=LostFocus}" Width="100" />
                                <DataGridTextColumn Header="测试值" Binding="{Binding TestValue}" Width="110" IsReadOnly="True" />
                                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="90" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

    <Border Width="360"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,54,18,0"
            Background="#FFFFFF"
            BorderBrush="#2563EB"
            BorderThickness="1"
            Padding="14"
            Panel.ZIndex="20">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPopupVisible}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <TextBlock Text="消息提示" FontSize="16" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,0,0,8" />
            <TextBlock Text="{Binding PopupMessage}" TextWrapping="Wrap" Foreground="#111827" Margin="0,0,0,12" />
            <Button Content="确认" Command="{Binding ConfirmPopupCommand}" Width="86" Height="30" HorizontalAlignment="Right">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PopupRequiresConfirmation}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
    </Grid>
</Window>






