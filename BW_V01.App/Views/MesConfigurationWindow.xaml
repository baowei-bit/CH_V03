<Window x:Class="BW_V01.App.Views.MesConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MES 设置"
        Width="900"
        Height="600"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="#52606D" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9E2EC" BorderThickness="1,1,0,0" Padding="14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Command="{Binding SaveCommand}" Width="96" Height="34" Margin="0,0,10,0" />
                <Button Content="退出" Command="{Binding CancelCommand}" Width="96" Height="34" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Border Background="White" BorderBrush="#D9E2EC" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="MES 设置" />
                        <UniformGrid Columns="3">
                            <CheckBox Content="启用 MES" IsChecked="{Binding Configuration.Mes.Enabled}" Margin="0,4,14,12" />
                            <CheckBox Content="允许离线缓存" IsChecked="{Binding Configuration.Mes.AllowOfflineCache}" Margin="0,4,14,12" />
                            <CheckBox Content="在线模式默认开启" IsChecked="{Binding Configuration.Mes.OnlineMode}" Margin="0,4,0,12" />
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Style="{StaticResource Label}" Text="MES 插件" />
                                <ComboBox ItemsSource="{Binding MesPluginChoices}"
                                          DisplayMemberPath="Description"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedMesPluginId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Style="{StaticResource Label}" Text="MES 地址" />
                                <TextBox Text="{Binding Configuration.Mes.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Label}" Text="工号/账号" />
                                <TextBox Text="{Binding Configuration.Mes.UserNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Style="{StaticResource Label}" Text="密码" />
                                <TextBox Text="{Binding Configuration.Mes.Password, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Style="{StaticResource Label}" Text="箱号" />
                                <TextBox Text="{Binding Configuration.Mes.PackNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Label}" Text="治具" />
                                <TextBox Text="{Binding Configuration.Mes.Tooling, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Style="{StaticResource Label}" Text="工单" />
                                <TextBox Text="{Binding Configuration.Mes.ProdNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        BorderBrush="#D9E2EC"
                        BorderThickness="1"
                        Padding="18"
                        Margin="0,14,0,0"
                        Visibility="{Binding HasPluginFields, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="插件参数" />
                        <ItemsControl ItemsSource="{Binding PluginFields}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,14,12">
                                        <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                                        <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Foreground="#94A3B8"
                                                   FontSize="11"
                                                   Text="{Binding HelpText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D9E2EC" BorderThickness="1" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="良率控制" />
                        <UniformGrid Columns="3">
                            <CheckBox x:Name="YieldControlCheckBox"
                                      Content="启用良率控制上传"
                                      IsChecked="{Binding Configuration.Mes.EnableYieldControlUploadToMes}"
                                      Margin="0,4,14,12" />
                            <StackPanel Margin="0,0,14,12" IsEnabled="{Binding IsChecked, ElementName=YieldControlCheckBox}">
                                <TextBlock Style="{StaticResource Label}" Text="上传阈值(%)" />
                                <TextBox Text="{Binding Configuration.Mes.YieldControlThreshold, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
