<Window x:Class="BW_V01.App.Views.TestItemConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="测试项配置"
        Width="960"
        Height="620"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9E2EC" BorderThickness="1,1,0,0" Padding="14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Command="{Binding SaveCommand}" Width="96" Height="34" Margin="0,0,10,0" />
                <Button Content="退出" Command="{Binding CancelCommand}" Width="96" Height="34" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1" Padding="14">
            <StackPanel Orientation="Horizontal">
                <Button Content="新增" Command="{Binding AddCommand}" Width="86" Height="32" Margin="0,0,8,0" />
                <Button Content="删除" Command="{Binding DeleteCommand}" Width="86" Height="32" Margin="0,0,8,0" />
                <Button Content="上移" Command="{Binding MoveUpCommand}" Width="86" Height="32" Margin="0,0,8,0" />
                <Button Content="下移" Command="{Binding MoveDownCommand}" Width="86" Height="32" />
            </StackPanel>
        </Border>

        <Border Background="White" BorderBrush="#D9E2EC" BorderThickness="1" Margin="18" Padding="12">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      GridLinesVisibility="All">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="顺序" Binding="{Binding Order, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                    <DataGridTextColumn Header="测试项目" Binding="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="下限" Binding="{Binding LowerLimit, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                    <DataGridTextColumn Header="上限" Binding="{Binding UpperLimit, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                    <DataGridTextColumn Header="单位" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    <DataGridTextColumn Header="点位A" Binding="{Binding PointA, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    <DataGridTextColumn Header="点位B" Binding="{Binding PointB, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
