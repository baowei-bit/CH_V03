<Window x:Class="BW_V01.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件帮助"
        Width="760"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9E2EC" BorderThickness="1,1,0,0" Padding="14">
            <Button Content="关闭" Command="{Binding CloseCommand}" Width="96" Height="34" HorizontalAlignment="Right" />
        </Border>
        <ScrollViewer Margin="18">
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding Version}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <UniformGrid Columns="2" Margin="0,0,0,18">
                        <TextBlock Text="客户" Foreground="#52606D" />
                        <TextBlock Text="{Binding CustomerName}" />
                        <TextBlock Text="产品" Foreground="#52606D" />
                        <TextBlock Text="{Binding ProductName}" />
                        <TextBlock Text="MES插件" Foreground="#52606D" />
                        <TextBlock Text="{Binding MesPlugin}" />
                    </UniformGrid>
                    <TextBlock Text="操作流程" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="1. 在基础配置中确认客户、产品、站位、通讯方式和 MES 参数。&#x0a;2. 在用户配置中确认自动扫码、连续 NG 报警阈值和账号权限。&#x0a;3. 点击连接设备，等待扫码枪和下位机进入已连接状态。&#x0a;4. 下位机触发 DM 后，系统等待扫码；MES 启用时先执行卡关，通过后发送 DMOK。&#x0a;5. 测试完成后系统解析结果、更新良率、生成 CSV/DCL/CsvMes，并按配置上传 MES。" />
                    <TextBlock Text="权限说明" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="操作员可执行生产操作；工程师除导入客户方案外可使用其他功能；管理员拥有所有权限。当前默认账号：operator/123456，engineer/123，admin/admin。" />
                    <TextBlock Text="MES插件" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap"
                               Text="MES 插件 DLL 放在程序目录 plugins\mes 下，插件类实现 IMesPlugin。配置中的 SelectedPlugin 必须与插件 Id 一致，例如 SwiftMom.Http。" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
