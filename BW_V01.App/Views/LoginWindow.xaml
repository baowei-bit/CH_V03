<Window x:Class="BW_V01.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户登录"
        Width="820"
        Height="520"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/company-icon.png"
        ResizeMode="NoResize"
        Background="#EAF7FF">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EAF8FF" Offset="0" />
                <GradientStop Color="#BFE9FF" Offset="0.52" />
                <GradientStop Color="#DDF3F2" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="380" Height="380" Fill="#70FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-130,-125,0,0" />
        <Ellipse Width="280" Height="280" Fill="#55A7D8FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80" />
        <Rectangle Height="130" Fill="#40FFFFFF" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="-8" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <Grid Margin="54,48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="372" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,56,0">
                <Image Source="/Assets/company-logo.png" Width="188" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="欢迎使用测昊测试系统" Foreground="#174A63" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="42" />
                    <TextBlock Text="让每一次测试更精准、更高效、更可靠。" Foreground="#34657A" FontSize="15" Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="24" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" BorderBrush="#A9D5E8" BorderThickness="1" Padding="30" CornerRadius="8">
                <Border.Background>
                    <SolidColorBrush Color="#F3FBFF" Opacity="0.92" />
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#7AAFC4" BlurRadius="18" ShadowDepth="0" Opacity="0.22" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="用户登录" FontSize="22" FontWeight="SemiBold" Foreground="#15384A" LineHeight="30" />
                        <TextBlock Text="输入账号密码后进入系统" Foreground="#536D7A" Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="账号" Foreground="#536D7A" Margin="0,14,0,6" />
                    <TextBox Grid.Row="2" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="10,6" />
                    <TextBlock Grid.Row="3" Text="密码" Foreground="#536D7A" Margin="0,14,0,6" />
                    <TextBox Grid.Row="4" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="10,6" />
                    <TextBlock Grid.Row="5" Text="{Binding Message}" Foreground="#B91C1C" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="登录" Command="{Binding LoginCommand}" Width="92" Height="34" Margin="0,0,10,0" />
                        <Button Content="取消" Command="{Binding CancelCommand}" Width="92" Height="34" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
