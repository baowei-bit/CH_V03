<Window x:Class="BW_V01.App.Views.BasicConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="基础配置"
        Width="940"
        Height="620"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="#52606D" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9E2EC" BorderThickness="1,1,0,0" Padding="14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Command="{Binding SaveCommand}" Width="96" Height="34" Margin="0,0,10,0" />
                <Button Content="退出" Command="{Binding CancelCommand}" Width="96" Height="34" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Border Background="White" BorderBrush="#D9E2EC" BorderThickness="1" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="系统设置" />
                        <UniformGrid Columns="3" Rows="4">
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Style="{StaticResource Label}" Text="客户名称" />
                                <TextBox Text="{Binding Configuration.Identity.CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Style="{StaticResource Label}" Text="产品名称" />
                                <TextBox Text="{Binding Configuration.Identity.ProductName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Label}" Text="测试类型" />
                                <TextBox Text="{Binding Configuration.Identity.TestType, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Style="{StaticResource Label}" Text="测试程式" />
                                <TextBox Text="{Binding Configuration.Identity.TestProgram, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Style="{StaticResource Label}" Text="站位编号" />
                                <TextBox Text="{Binding Configuration.Identity.StationNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Label}" Text="机台编号" />
                                <TextBox Text="{Binding Configuration.Identity.MachineNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Style="{StaticResource Label}" Text="条码长度" />
                                <TextBox Text="{Binding Configuration.Identity.BarcodeLength, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Style="{StaticResource Label}" Text="条码固定校验码" />
                                <TextBox Text="{Binding Configuration.Identity.CodeSuffix, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0">
                                <TextBlock Style="{StaticResource Label}" Text="CSV 文件前缀" />
                                <TextBox Text="{Binding Configuration.Output.CsvName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <CheckBox Content="显示消息弹窗" IsChecked="{Binding Configuration.Popup.Enabled}" Margin="0,8,14,0" VerticalAlignment="Center" />
                            <CheckBox Content="弹窗需要确认" IsChecked="{Binding Configuration.Popup.RequireConfirmation}" Margin="0,8,14,0" VerticalAlignment="Center" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D9E2EC" BorderThickness="1" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="导出器插件" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="当前导出器" Margin="0,0,12,10" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding ExportPluginChoices}"
                                      DisplayMemberPath="Description"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedExportPluginId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#64748B" TextWrapping="Wrap"
                                       Text="不选择客户导出器时使用默认导出：CSV、DCL、CsvMes。选择客户导出器后，测试完成时只执行该客户导出插件。" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding PluginFields}"
                                      Margin="0,16,0,0"
                                      Visibility="{Binding HasPluginFields, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,14,12">
                                        <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                                        <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Foreground="#94A3B8"
                                                   FontSize="11"
                                                   Text="{Binding HelpText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D9E2EC" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="保存路径" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="运行日志路径" Margin="0,0,12,12" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Configuration.Output.LogDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DCL/TXT 保存路径" Margin="0,0,12,12" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Configuration.Output.DclDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="产品 CSV 保存路径" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Configuration.Output.CsvDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
