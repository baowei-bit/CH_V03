<Window x:Class="BW_V01.App.Views.UserConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户配置"
        Width="860"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="#52606D" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9E2EC" BorderThickness="1,1,0,0" Padding="14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Command="{Binding SaveCommand}" Width="96" Height="34" Margin="0,0,10,0" />
                <Button Content="退出" Command="{Binding CancelCommand}" Width="96" Height="34" />
            </StackPanel>
        </Border>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#D9E2EC" BorderThickness="1" Padding="18">
                <GroupBox Header="用户操作设置" Padding="16" FontSize="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" Content="自动扫码" IsChecked="{Binding Configuration.AutoScan}" VerticalAlignment="Center" />

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="连续 NG 报警数量" />
                            <TextBox Text="{Binding Configuration.ConsecutiveNgAlarmCount, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="登录工号" />
                            <TextBox Text="{Binding Configuration.LoginJobNo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="治具编号" />
                            <TextBox Text="{Binding Configuration.FixtureNo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="#D9E2EC" BorderThickness="1" Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="账号权限" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Configuration.Accounts}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="账号" Binding="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            <DataGridTextColumn Header="密码" Binding="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            <DataGridTextColumn Header="角色" Binding="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
