<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BW_V01.Core\BW_V01.Core.csproj" />
    <ProjectReference Include="..\BW_V01.Plugins\Mes\BW_V01.Mes.SwiftMomHttp\BW_V01.Mes.SwiftMomHttp.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\BW_V01.Plugins\Mes\BW_V01.Mes.JiaLianYiCareerRule\BW_V01.Mes.JiaLianYiCareerRule.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\BW_V01.Plugins\Mes\BW_V01.Mes.SuzhouJiaLianYiLuEnZe\BW_V01.Mes.SuzhouJiaLianYiLuEnZe.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\BW_V01.Plugins\Mes\BW_V01.Mes.SuzhouWeiXin\BW_V01.Mes.SuzhouWeiXin.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\BW_V01.Plugins\Export\BW_V01.Export.JiaLianYi\BW_V01.Export.JiaLianYi.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\BW_V01.Plugins\Export\BW_V01.Export.SuzhouJiaLianYiLuEnZe\BW_V01.Export.SuzhouJiaLianYiLuEnZe.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\BW_V01.Plugins\Export\BW_V01.Export.SuzhouWeiXin\BW_V01.Export.SuzhouWeiXin.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
     <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\company-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\company-logo.png" />
    <Resource Include="Assets\company-icon.png" />
    <Resource Include="Assets\company-logo-full.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\BW_V01.Plugins\profiles\*.json">
      <Link>profiles\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>


  <Target Name="CopyMesPlugins" AfterTargets="Build">
    <ItemGroup>
      <MesPluginFiles Include="..\BW_V01.Plugins\Mes\BW_V01.Mes.SwiftMomHttp\bin\$(Configuration)\net8.0\BW_V01.Mes.SwiftMomHttp.dll" />
      <MesPluginFiles Include="..\BW_V01.Plugins\Mes\BW_V01.Mes.JiaLianYiCareerRule\bin\$(Configuration)\net8.0\BW_V01.Mes.JiaLianYiCareerRule.dll" />
      <MesPluginFiles Include="..\BW_V01.Plugins\Mes\BW_V01.Mes.JiaLianYiCareerRule\bin\$(Configuration)\net8.0\CareerRule.dll" />
      <MesPluginFiles Include="..\BW_V01.Plugins\Mes\BW_V01.Mes.SuzhouJiaLianYiLuEnZe\bin\$(Configuration)\net8.0\BW_V01.Mes.SuzhouJiaLianYiLuEnZe.dll" />
      <MesPluginFiles Include="..\BW_V01.Plugins\Mes\BW_V01.Mes.SuzhouWeiXin\bin\$(Configuration)\net8.0\BW_V01.Mes.SuzhouWeiXin.dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)plugins\mes" />
    <Copy SourceFiles="@(MesPluginFiles)" DestinationFolder="$(OutputPath)plugins\mes" SkipUnchangedFiles="true" Condition="Exists('%(MesPluginFiles.Identity)')" />
  </Target>

  <Target Name="CopyExportPlugins" AfterTargets="Build">
    <ItemGroup>
      <ExportPluginFiles Include="..\BW_V01.Plugins\Export\BW_V01.Export.JiaLianYi\bin\$(Configuration)\net8.0\BW_V01.Export.JiaLianYi.dll" />
      <ExportPluginFiles Include="..\BW_V01.Plugins\Export\BW_V01.Export.SuzhouJiaLianYiLuEnZe\bin\$(Configuration)\net8.0\BW_V01.Export.SuzhouJiaLianYiLuEnZe.dll" />
      <ExportPluginFiles Include="..\BW_V01.Plugins\Export\BW_V01.Export.SuzhouWeiXin\bin\$(Configuration)\net8.0\BW_V01.Export.SuzhouWeiXin.dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)plugins\export" />
    <Copy SourceFiles="@(ExportPluginFiles)" DestinationFolder="$(OutputPath)plugins\export" SkipUnchangedFiles="true" Condition="Exists('%(ExportPluginFiles.Identity)')" />
  </Target>
</Project>




