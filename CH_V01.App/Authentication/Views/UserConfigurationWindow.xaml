<Window x:Class="CH_V01.App.Views.UserConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CH_V01.App.Converters"
        Title="用户配置"
        Width="860"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#EAF7FF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:ConfigurationFieldVisibilityConverter x:Key="FieldVisibility" />
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="#52606D" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#7DD3FC" BorderThickness="1,1,0,0" Padding="14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Command="{Binding SaveCommand}" Width="96" Height="34" Margin="0,0,10,0" />
                <Button Content="退出" Command="{Binding CancelCommand}" Width="96" Height="34" />
            </StackPanel>
        </Border>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18">
                <GroupBox Header="用户操作设置" Padding="16" FontSize="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <RadioButton Content="自动扫码" GroupName="ScanMode" IsChecked="{Binding IsAutoScanMode}" VerticalAlignment="Center"
                                       Visibility="{Binding Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=User.AutoScan}" />
                            <RadioButton Content="手动扫码" GroupName="ScanMode" IsChecked="{Binding IsManualScanMode}" Margin="0,10,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=User.AutoScan}" />
                            <CheckBox Content="扫码先行（扫码成功后等待下位机 DM）" IsChecked="{Binding Configuration.ScanAheadEnabled}" Margin="24,6,0,0" VerticalAlignment="Center"
                                      Visibility="{Binding IsManualScanMode, Converter={StaticResource BoolToVisibility}}" />
                            <RadioButton Content="不扫码" GroupName="ScanMode" IsChecked="{Binding IsNoScanMode}" Margin="0,10,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=User.NoScanMode}" />
                            <CheckBox Content="保存当天数量" IsChecked="{Binding Configuration.SaveDailyQuantity}" Margin="0,10,0,0" VerticalAlignment="Center"
                                      ToolTip="启用后，当天的 PASS、FAIL、总数和良率会在软件重启后保留；次日启动时自动清零。" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Visibility="{Binding Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=User.ConsecutiveNgAlarmCount}">
                            <TextBlock Style="{StaticResource Label}" Text="连续 NG 报警数量" />
                            <TextBox Text="{Binding Configuration.ConsecutiveNgAlarmCount, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Visibility="{Binding Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=User.LoginJobNo}">
                            <TextBlock Style="{StaticResource Label}" Text="登录工号" />
                            <TextBox Text="{Binding Configuration.LoginJobNo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Visibility="{Binding Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=User.FixtureNo}">
                            <TextBlock Style="{StaticResource Label}" Text="治具编号" />
                            <TextBox Text="{Binding Configuration.FixtureNo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18"
                    Visibility="{Binding CanManageAccounts, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="账号权限" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Configuration.Accounts}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="账号" Binding="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            <DataGridTextColumn Header="密码" Binding="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            <DataGridTextColumn Header="角色" Binding="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
