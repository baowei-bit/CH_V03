<Window x:Class="CH_V01.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户登录"
        Width="960"
        Height="560"
        MinWidth="900"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/company-icon.png"
        ResizeMode="NoResize"
        Background="#EAF7FF">
    <Window.Resources>
        <Style x:Key="LoginInput" TargetType="TextBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#7DD3FC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#0EA5E9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EAF8FF" Offset="0" />
                <GradientStop Color="#BFE9FF" Offset="0.52" />
                <GradientStop Color="#DDF3F2" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="380" Height="380" Fill="#70FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-130,-125,0,0" />
        <Ellipse Width="280" Height="280" Fill="#55A7D8FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80" />
        <Rectangle Height="130" Fill="#40FFFFFF" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="-8" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <Grid Margin="54,52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="396" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,42,0">
                <Image Source="/Assets/company-logo.png" Width="188" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="#174A63"
                               FontSize="28"
                               FontWeight="SemiBold"
                               LineHeight="40"
                               TextWrapping="NoWrap">
                        <Run Text="欢迎使用  测昊" />
                        <LineBreak />
                        <Run Text="工业自动化测试工作站" />
                    </TextBlock>
                    <TextBlock Text="让每一次测试更精准、更高效、更可靠。"
                               Foreground="#34657A"
                               FontSize="15"
                               Margin="0,18,0,0"
                               TextWrapping="Wrap"
                               LineHeight="24" />
                </StackPanel>
                <TextBlock Text="{Binding Version}"
                           VerticalAlignment="Bottom"
                           Foreground="#34657A"
                           FontSize="14"
                           Margin="0,0,0,28" />
            </Grid>

            <Border Grid.Column="1" BorderBrush="#38BDF8" BorderThickness="1" Padding="34" CornerRadius="10">
                <Border.Background>
                    <SolidColorBrush Color="#F3FBFF" Opacity="0.92" />
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#7AAFC4" BlurRadius="18" ShadowDepth="0" Opacity="0.22" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="52" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="用户登录" FontSize="22" FontWeight="SemiBold" Foreground="#15384A" LineHeight="30" />
                        <TextBlock Text="输入账号密码后进入系统" Foreground="#536D7A" Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="账号" Foreground="#536D7A" Margin="0,14,0,6" />
                    <TextBox Grid.Row="2" Style="{StaticResource LoginInput}" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Text="密码" Foreground="#536D7A" Margin="0,14,0,6" />
                    <TextBox Grid.Row="4" Style="{StaticResource LoginInput}" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="5" Text="{Binding Message}" Foreground="#B91C1C" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="登录" Command="{Binding LoginCommand}" Width="104" Height="36" Margin="0,0,12,0" />
                        <Button Content="取消" Command="{Binding CancelCommand}" Width="104" Height="36" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
