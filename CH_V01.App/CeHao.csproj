<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CH_V01.Core\CH_V01.Core.csproj" />
    <ProjectReference Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.SwiftMomHttp\CH_V01.Mes.SwiftMomHttp.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.PBHMes\CH_V01.Mes.PBHMes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.JiaLianYiCareerRule\CH_V01.Mes.JiaLianYiCareerRule.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.SuzhouJiaLianYiLuEnZe\CH_V01.Mes.SuzhouJiaLianYiLuEnZe.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.SuzhouWeiXin\CH_V01.Mes.SuzhouWeiXin.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.Bomin\CH_V01.Mes.Bomin.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.YiDongEap\CH_V01.Mes.YiDongEap.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\CH_V01.Plugins\Export\CH_V01.Export.JiaLianYi\CH_V01.Export.JiaLianYi.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\CH_V01.Plugins\Export\CH_V01.Export.SuzhouJiaLianYiLuEnZe\CH_V01.Export.SuzhouJiaLianYiLuEnZe.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\CH_V01.Plugins\Export\CH_V01.Export.SuzhouWeiXin\CH_V01.Export.SuzhouWeiXin.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\CH_V01.Plugins\Export\CH_V01.Export.Bomin\CH_V01.Export.Bomin.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\CH_V01.Plugins\Export\CH_V01.Export.YiDongEap\CH_V01.Export.YiDongEap.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
  </ItemGroup>

  <PropertyGroup>
     <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\company-icon.ico</ApplicationIcon>
    <AssemblyName>CeHao</AssemblyName>
    <Product>CeHao</Product>
    <Version>2.0.27</Version>
    <AssemblyVersion>2.0.27.0</AssemblyVersion>
    <FileVersion>2.0.27.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\company-logo.png" />
    <Resource Include="Assets\company-icon.png" />
    <Resource Include="Assets\company-logo-full.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\CH_V01.Plugins\profiles\*.json">
      <Link>profiles\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>


  <Target Name="CopyMesPlugins" AfterTargets="Build">
    <ItemGroup>
      <MesPluginFiles Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.SwiftMomHttp\bin\$(Configuration)\net8.0\CH_V01.Mes.SwiftMomHttp.dll" />
      <MesPluginFiles Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.PBHMes\bin\$(Configuration)\net8.0\CH_V01.Mes.PBHMes.dll" />
      <MesPluginFiles Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.JiaLianYiCareerRule\bin\$(Configuration)\net8.0\CH_V01.Mes.JiaLianYiCareerRule.dll" />
      <MesPluginFiles Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.JiaLianYiCareerRule\bin\$(Configuration)\net8.0\CareerRule.dll" />
      <MesPluginFiles Include="$(OutputPath)Newtonsoft.Json.dll" />
      <MesPluginFiles Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.SuzhouJiaLianYiLuEnZe\bin\$(Configuration)\net8.0\CH_V01.Mes.SuzhouJiaLianYiLuEnZe.dll" />
      <MesPluginFiles Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.SuzhouWeiXin\bin\$(Configuration)\net8.0\CH_V01.Mes.SuzhouWeiXin.dll" />
      <MesPluginFiles Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.Bomin\bin\$(Configuration)\net8.0\CH_V01.Mes.Bomin.dll" />
      <MesPluginFiles Include="..\CH_V01.Plugins\Mes\CH_V01.Mes.YiDongEap\bin\$(Configuration)\net8.0\CH_V01.Mes.YiDongEap.dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)plugins\mes" />
    <ItemGroup>
      <StaleMesPluginFiles Include="$(OutputPath)plugins\mes\BW_V01.*.dll" />
    </ItemGroup>
    <Delete Files="@(StaleMesPluginFiles)" />
    <Copy SourceFiles="@(MesPluginFiles)" DestinationFolder="$(OutputPath)plugins\mes" SkipUnchangedFiles="true" Condition="Exists('%(MesPluginFiles.Identity)')" />
  </Target>

  <Target Name="CopyExportPlugins" AfterTargets="Build">
    <ItemGroup>
      <ExportPluginFiles Include="..\CH_V01.Plugins\Export\CH_V01.Export.JiaLianYi\bin\$(Configuration)\net8.0\CH_V01.Export.JiaLianYi.dll" />
      <ExportPluginFiles Include="..\CH_V01.Plugins\Export\CH_V01.Export.SuzhouJiaLianYiLuEnZe\bin\$(Configuration)\net8.0\CH_V01.Export.SuzhouJiaLianYiLuEnZe.dll" />
      <ExportPluginFiles Include="..\CH_V01.Plugins\Export\CH_V01.Export.SuzhouWeiXin\bin\$(Configuration)\net8.0\CH_V01.Export.SuzhouWeiXin.dll" />
      <ExportPluginFiles Include="..\CH_V01.Plugins\Export\CH_V01.Export.Bomin\bin\$(Configuration)\net8.0\CH_V01.Export.Bomin.dll" />
      <ExportPluginFiles Include="..\CH_V01.Plugins\Export\CH_V01.Export.YiDongEap\bin\$(Configuration)\net8.0\CH_V01.Export.YiDongEap.dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)plugins\export" />
    <ItemGroup>
      <StaleExportPluginFiles Include="$(OutputPath)plugins\export\BW_V01.*.dll" />
    </ItemGroup>
    <Delete Files="@(StaleExportPluginFiles)" />
    <Copy SourceFiles="@(ExportPluginFiles)" DestinationFolder="$(OutputPath)plugins\export" SkipUnchangedFiles="true" Condition="Exists('%(ExportPluginFiles.Identity)')" />
  </Target>

  <Target Name="CopyPluginsToPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <MesPluginPublishFiles Include="$(TargetDir)plugins\mes\*.dll" />
      <ExportPluginPublishFiles Include="$(TargetDir)plugins\export\*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)plugins\mes" />
    <MakeDir Directories="$(PublishDir)plugins\export" />
    <Copy SourceFiles="@(MesPluginPublishFiles)" DestinationFolder="$(PublishDir)plugins\mes" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ExportPluginPublishFiles)" DestinationFolder="$(PublishDir)plugins\export" SkipUnchangedFiles="true" />
  </Target>
</Project>




