<Window x:Class="CH_V01.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Height="820"
        Width="1260"
        MinHeight="720"
        MinWidth="1024"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/company-icon.png"
        Background="#EAF7FF">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.12" ShadowDepth="2" Color="#0369A1" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ValueBox" TargetType="TextBlock">
            <Setter Property="Background" Value="#F0F9FF" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ValueInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F0F9FF" />
            <Setter Property="BorderBrush" Value="#7DD3FC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="TinyState" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#94A3B8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="StatusBallButton" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="点击切换状态" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"
                                     Stroke="#FFFFFF"
                                     StrokeThickness="2" />
                            <Ellipse Margin="5,4,5,10" Fill="#66FFFFFF" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OuterStatusItem" TargetType="Button">
            <Setter Property="Background" Value="#F8FCFF" />
            <Setter Property="BorderBrush" Value="#BAE6FD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="点击切换连接状态" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StatusItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StatusItemBorder" Property="Background" Value="#E0F2FE" />
                                <Setter TargetName="StatusItemBorder" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StatusItemBorder" Property="Background" Value="#BAE6FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StandardPieceModeButton" TargetType="Button" BasedOn="{StaticResource OuterStatusItem}">
            <Style.Triggers><DataTrigger Binding="{Binding IsStandardPieceMode}" Value="True"><Setter Property="Background" Value="#16A34A" /><Setter Property="BorderBrush" Value="#15803D" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="TestPieceModeButton" TargetType="Button" BasedOn="{StaticResource OuterStatusItem}">
            <Style.Triggers><DataTrigger Binding="{Binding IsTestPieceMode}" Value="True"><Setter Property="Background" Value="#2563EB" /><Setter Property="BorderBrush" Value="#1D4ED8" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="DebugModeButton" TargetType="Button" BasedOn="{StaticResource OuterStatusItem}">
            <Style.Triggers><DataTrigger Binding="{Binding IsDebugMode}" Value="True"><Setter Property="Background" Value="#9333EA" /><Setter Property="BorderBrush" Value="#7E22CE" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#0F4C81" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#BAE6FD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#7DD3FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseTitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#0F4C81" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DC2626" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#B91C1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top"
              Height="34"
              Background="#E0F2FE">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,16,0">
                <Image Source="/Assets/company-icon.png" Width="20" Height="20" Margin="0,0,6,0" />
                <TextBlock Text="{Binding WindowTitle, Mode=OneWay}" Foreground="#0F4C81" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Button Style="{StaticResource OuterStatusItem}"
                        Command="{Binding ToggleScannerConnectionCommand}"
                        Focusable="False"
                        Visibility="{Binding IsStandardConfigurationMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18">
                            <Ellipse Fill="{Binding ScannerStateBrush}" Stroke="#FFFFFF" StrokeThickness="2" />
                            <Ellipse Margin="5,4,5,10" Fill="#66FFFFFF" />
                        </Grid>
                        <TextBlock Text="扫码枪" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource OuterStatusItem}"
                        Command="{Binding ToggleLowerMachineConnectionCommand}"
                        Visibility="{Binding IsStandardConfigurationMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18">
                            <Ellipse Fill="{Binding LowerMachineStateBrush}" Stroke="#FFFFFF" StrokeThickness="2" />
                            <Ellipse Margin="5,4,5,10" Fill="#66FFFFFF" />
                        </Grid>
                        <TextBlock Text="下位机" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource OuterStatusItem}"
                        Command="{Binding ToggleOnlineModeCommand}"
                        Visibility="{Binding IsStandardConfigurationMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18">
                            <Ellipse Fill="{Binding MesStateBrush}" Stroke="#FFFFFF" StrokeThickness="2" />
                            <Ellipse Margin="5,4,5,10" Fill="#66FFFFFF" />
                        </Grid>
                        <TextBlock Text="MES" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsKunshanJiaLianYiDedicatedConfiguration, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="#F8FCFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="{Binding ScannerStateBrush}" Margin="0,0,6,0" /><TextBlock Text="{Binding ScannerState}" FontSize="12" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border Background="#F8FCFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="{Binding LowerMachineStateBrush}" Margin="0,0,6,0" /><TextBlock Text="{Binding LowerMachineState}" FontSize="12" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border Background="#F8FCFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="{Binding MesStateBrush}" Margin="0,0,6,0" /><TextBlock Text="{Binding MesState}" FontSize="12" FontWeight="SemiBold" /></StackPanel></Border>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="{Binding LogToggleText}"
                    Command="{Binding ToggleLogVisibilityCommand}"
                    Height="26"
                    MinWidth="88"
                    Padding="12,0"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />

            <Button Grid.Column="3"
                    Content="管理员工具"
                    Command="{Binding ToggleAdminToolsCommand}"
                    Height="26"
                    MinWidth="96"
                    Padding="12,0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Visibility="{Binding CanUseAdminTools, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <StackPanel Grid.Column="4" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}" Content="—" Click="MinimizeButton_Click" />
                <Button Style="{StaticResource TitleBarButton}" Content="□" Click="MaximizeButton_Click" />
                <Button Style="{StaticResource CloseTitleBarButton}" Content="×" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <Menu DockPanel.Dock="Top" Background="#BAE6FD" BorderBrush="#38BDF8" BorderThickness="0,0,0,1">
            <MenuItem Header="配置管理" Visibility="{Binding IsStandardConfigurationMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem Header="项目基础">
                    <MenuItem Header="基础配置"
                              Command="{Binding OpenBasicConfigurationCommand}"
                              IsEnabled="{Binding CanOpenBasicConfiguration}" />
                    <MenuItem Header="导入客户方案"
                              Command="{Binding ImportProjectProfileCommand}"
                              Visibility="{Binding CanImportProjectProfile, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Separator Visibility="{Binding CanImportProjectProfile, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <MenuItem Header="保存配置"
                              Command="{Binding SaveConfigurationCommand}"
                              Visibility="{Binding CanManageSystem, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </MenuItem>
                <MenuItem Header="设备通讯">
                    <MenuItem Header="扫码枪 / 下位机通讯"
                              Command="{Binding OpenCommunicationConfigurationCommand}"
                              IsEnabled="{Binding CanOpenCommunicationConfiguration}" />
                </MenuItem>
                <MenuItem Header="MES 与插件"
                          Visibility="{Binding CanManageSystem, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <MenuItem Header="MES 配置"
                              Command="{Binding OpenMesConfigurationCommand}"
                              IsEnabled="{Binding CanManageSystem}" />
                    <MenuItem Header="MES调试工具"
                              Command="{Binding OpenMesDebugToolCommand}"
                              IsEnabled="{Binding CanManageSystem}" />
                    <MenuItem Header="插件配置"
                              Command="{Binding OpenPluginConfigurationCommand}"
                              IsEnabled="{Binding CanManageSystem}" />
                </MenuItem>
                <MenuItem Header="测试流程"
                          Visibility="{Binding CanManageTestItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <MenuItem Header="测试项配置"
                              Command="{Binding OpenTestItemConfigurationCommand}"
                              IsEnabled="{Binding CanManageTestItems}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="账号管理"
                      Visibility="{Binding CanManageUsersInStandardMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem Header="用户配置"
                          Command="{Binding OpenUserConfigurationCommand}"
                          IsEnabled="{Binding CanManageUsers}" />
                <MenuItem Header="切换登录" Command="{Binding SwitchLoginCommand}" />
            </MenuItem>
            <MenuItem Header="昆山嘉联益配置"
                      Visibility="{Binding IsKunshanJiaLianYiDedicatedConfiguration, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem Header="基础资料"
                          Command="{Binding OpenBasicConfigurationCommand}"
                          IsEnabled="{Binding CanOpenBasicConfiguration}" />
                <MenuItem Header="MES 与导出设置"
                          Command="{Binding OpenKunshanJiaLianYiConfigurationCommand}"
                          IsEnabled="{Binding CanManageSystem}" />
                <MenuItem Header="用户设置"
                          Command="{Binding OpenUserConfigurationCommand}"
                          IsEnabled="{Binding CanManageUsers}" />
                <MenuItem Header="扫码枪 / 下位机通讯"
                          Command="{Binding OpenCommunicationConfigurationCommand}"
                          IsEnabled="{Binding CanOpenCommunicationConfiguration}" />
                <MenuItem Header="切换登录" Command="{Binding SwitchLoginCommand}" />
            </MenuItem>
            <MenuItem Header="运行数据"
                      Visibility="{Binding CanViewAnalysisInStandardMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem Header="数据分析"
                          Command="{Binding OpenDataAnalysisCommand}"
                          IsEnabled="{Binding CanViewAnalysis}" />
            </MenuItem>
            <MenuItem Header="帮助"
                      Visibility="{Binding CanViewHelpInStandardMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem Header="软件帮助" Command="{Binding HelpCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#38BDF8" BorderThickness="0,0,0,1" Padding="0,8">
            <Grid>
                <TextBlock Text="{Binding HeaderTitle}" FontSize="30" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border Background="{Binding JiaLianYiRunModeBackground}"
                        BorderBrush="{Binding JiaLianYiRunModeBackground}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="18,6"
                        Width="310"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,24,0"
                        Visibility="{Binding IsKunshanJiaLianYiDedicatedConfiguration, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding JiaLianYiRunModeText}"
                               Foreground="{Binding JiaLianYiRunModeForeground}"
                               FontSize="26"
                               FontWeight="Bold"
                               TextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="0,1,0,0">
            <StatusBarItem Content="{Binding StatusMessage}" />
            <Separator />
            <StatusBarItem Content="{Binding LoginDisplay}" />
        </StatusBar>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="210" />
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42*" />
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="28*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,18,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="SN" FontSize="18" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueBox}" Text="{Binding CurrentBarcode}" FontSize="18" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="FAIL项" FontSize="18" Margin="0,12,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueBox}" Text="{Binding LastFailItem}" FontSize="18" Margin="0,12,0,0" />
                        </Grid>

                        <Border Grid.Column="1" BorderBrush="#BAE6FD" BorderThickness="1,0,1,0" Padding="18,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding TestState}" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2563EB" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TestState}" Value="PASS">
                                                    <Setter Property="Foreground" Value="#16A34A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TestState}" Value="FAIL">
                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TestState}" Value="WAIT">
                                                    <Setter Property="Foreground" Value="#CA8A04" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding TestTime}" FontSize="22" Foreground="#374151" HorizontalAlignment="Center" Margin="0,4,0,8" />
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12">
                                    <Run Text="上一次：" />
                                    <Run Text="{Binding LastTestResult, Mode=OneWay}" />
                                </TextBlock>
                                <Button Content="清空良率"
                                        Command="{Binding ClearYieldCommand}"
                                        Height="34"
                                        MaxWidth="220"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="2" Margin="18,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="站别" Margin="0,0,10,8" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueBox}" Text="{Binding StationNo}" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="工单" Margin="0,0,10,8" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource ValueBox}" Text="{Binding MesProdNo}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="总数" Margin="0,0,10,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueBox}" Text="{Binding TotalCount}" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="良率" Margin="0,0,10,8" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource ValueBox}" Text="{Binding YieldRateText}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Pass/Fail" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource ValueBox}" Text="{Binding PassFailText}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Border Style="{StaticResource Panel}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="测试项目" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding TestItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="False"
                                  FontFamily="Microsoft YaHei UI"
                                  FontSize="15"
                                  RowHeight="36"
                                  ColumnHeaderHeight="36"
                                  GridLinesVisibility="All"
                                  BorderBrush="#38BDF8"
                                  BorderThickness="1"
                                  HeadersVisibility="Column"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  RowBackground="#FFFFFF"
                                  AlternatingRowBackground="#F8FCFF"
                                  SnapsToDevicePixels="True"
                                  TextOptions.TextFormattingMode="Display"
                                  TextOptions.TextRenderingMode="ClearType">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#E0F2FE" />
                                    <Setter Property="Foreground" Value="#0F172A" />
                                    <Setter Property="FontSize" Value="15" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#111827" />
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="BorderBrush" Value="#BAE6FD" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                                    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result}" Value="OK">
                                            <Setter Property="Background" Value="#16A34A" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="BorderBrush" Value="#15803D" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result}" Value="NG">
                                            <Setter Property="Background" Value="#DC2626" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="BorderBrush" Value="#B91C1C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="FontWeight" Value="Medium" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result}" Value="OK">
                                            <Setter Property="Background" Value="#16A34A" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result}" Value="NG">
                                            <Setter Property="Background" Value="#DC2626" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="60" IsReadOnly="True" />
                                <DataGridTextColumn Header="测试项目" Binding="{Binding ItemName}" Width="2*" MinWidth="220" IsReadOnly="True" />
                                <DataGridTextColumn Header="点位A" Binding="{Binding PointA}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="点位B" Binding="{Binding PointB}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="上限" Binding="{Binding UpperLimit, UpdateSourceTrigger=LostFocus}" Width="100" />
                                <DataGridTextColumn Header="下限" Binding="{Binding LowerLimit, UpdateSourceTrigger=LostFocus}" Width="100" />
                                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="测试值" Binding="{Binding TestValue}" Width="120" IsReadOnly="True" />
                                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="90" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource Panel}"
                    Margin="0,8,0,0"
                    Height="165"
                    Visibility="{Binding IsLogVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="运行日志" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="13" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>

    <Border Width="360"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,18,42"
            Background="#FFFFFF"
            BorderBrush="#0EA5E9"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Panel.ZIndex="18">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdminToolsVisible}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <TextBlock Text="管理员工具" FontSize="15" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,0,0,10" />
            <UniformGrid Columns="2">
                <Button Content="初始化" Command="{Binding InitializeFlowCommand}" Height="32" Margin="0,0,6,8" />
                <Button Content="模拟DM" Command="{Binding SimulateLowerMachineStartCommand}" Height="32" Margin="6,0,0,8" />
                <Button Content="模拟扫码" Command="{Binding SimulateScanCommand}" Height="32" Margin="0,0,6,8" />
                <Button Content="模拟PASS" Command="{Binding SimulatePassCommand}" Height="32" Margin="6,0,0,8" />
                <Button Content="模拟FAIL" Command="{Binding SimulateFailCommand}" Height="32" Margin="0,0,6,0" />
                <Button Content="模拟消息提醒" Command="{Binding SimulatePopupCommand}" Height="32" Margin="6,0,0,0" />
            </UniformGrid>
        </StackPanel>
    </Border>

    <Border
            BorderThickness="2"
            CornerRadius="10"
            Panel.ZIndex="20">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#FFF7CC" />
                <Setter Property="BorderBrush" Value="#D97706" />
                <Setter Property="Width" Value="420" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,108,18,0" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPopupVisible}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPopupCenteredAndEnlarged}" Value="True">
                        <Setter Property="Width" Value="680" />
                        <Setter Property="MinHeight" Value="240" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="28" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPopupRedAlert}" Value="True">
                        <Setter Property="Background" Value="#FEE2E2" />
                        <Setter Property="BorderBrush" Value="#DC2626" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Button Command="{Binding ConfirmPopupCommand}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Cursor="Hand"
                Focusable="False"
                ToolTip="点击消息框即可关闭">
            <StackPanel>
                <TextBlock Text="MES / 系统消息提醒" FontWeight="Bold" Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="19" />
                            <Setter Property="Foreground" Value="#92400E" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPopupCenteredAndEnlarged}" Value="True">
                                    <Setter Property="FontSize" Value="26" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPopupRedAlert}" Value="True">
                                    <Setter Property="Foreground" Value="#991B1B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding PopupMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="Foreground" Value="#451A03" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPopupCenteredAndEnlarged}" Value="True">
                                    <Setter Property="FontSize" Value="22" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPopupRedAlert}" Value="True">
                                    <Setter Property="Foreground" Value="#7F1D1D" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="点击此消息框关闭">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="#A16207" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPopupCenteredAndEnlarged}" Value="True">
                                    <Setter Property="FontSize" Value="15" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPopupRedAlert}" Value="True">
                                    <Setter Property="Foreground" Value="#B91C1C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Button>
    </Border>
    </Grid>
</Window>






