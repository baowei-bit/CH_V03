<Window x:Class="CH_V01.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件帮助"
        Width="760"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#EAF7FF">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#7DD3FC" BorderThickness="1,1,0,0" Padding="14">
            <Button Content="关闭" Command="{Binding CloseCommand}" Width="96" Height="34" HorizontalAlignment="Right" />
        </Border>
        <ScrollViewer Margin="18">
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding ProductTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Version}" FontSize="15" Foreground="#52606D" Margin="0,0,0,14" />
                    <UniformGrid Columns="2" Margin="0,0,0,18">
                        <TextBlock Text="产品" Foreground="#52606D" />
                        <TextBlock Text="{Binding ProductName}" />
                        <TextBlock Text="MES插件" Foreground="#52606D" />
                        <TextBlock Text="{Binding MesPlugin}" />
                    </UniformGrid>
                    <TextBlock Text="版本迭代" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap"
                               Text="{Binding VersionHistory}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
