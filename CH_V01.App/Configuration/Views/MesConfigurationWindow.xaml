<Window x:Class="CH_V01.App.Views.MesConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CH_V01.App.Converters"
        Title="MES 配置"
        Width="900"
        Height="600"
        MinWidth="780"
        MinHeight="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#EAF7FF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:ConfigurationFieldVisibilityConverter x:Key="FieldVisibility" />
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="#52606D" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#7DD3FC" BorderThickness="1,1,0,0" Padding="14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Command="{Binding SaveCommand}" Width="96" Height="34" Margin="0,0,10,0" />
                <Button Content="退出" Command="{Binding CancelCommand}" Width="96" Height="34" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="MES 设置" />
                        <UniformGrid Columns="3">
                            <CheckBox Content="启用 MES" IsChecked="{Binding Configuration.Mes.Enabled}" Margin="0,4,14,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Mes.Enabled}" />
                            <CheckBox Content="允许离线缓存" IsChecked="{Binding Configuration.Mes.AllowOfflineCache}" Margin="0,4,14,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Mes.AllowOfflineCache}" />
                            <CheckBox Content="在线模式默认开启" IsChecked="{Binding Configuration.Mes.OnlineMode}" Margin="0,4,0,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Mes.OnlineMode}" />
                            <StackPanel Margin="0,0,14,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Identity.StationNo}">
                                <TextBlock Style="{StaticResource Label}" Text="站位" />
                                <TextBox Text="{Binding Configuration.Identity.StationNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Mes.BaseUrl}">
                                <TextBlock Style="{StaticResource Label}" Text="MES 地址" />
                                <TextBox Text="{Binding Configuration.Mes.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Mes.UserNo}">
                                <TextBlock Style="{StaticResource Label}" Text="工号/账号" />
                                <TextBox Text="{Binding Configuration.Mes.UserNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Mes.Password}">
                                <TextBlock Style="{StaticResource Label}" Text="密码" />
                                <TextBox Text="{Binding Configuration.Mes.Password, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Mes.PackNo}">
                                <TextBlock Style="{StaticResource Label}" Text="箱号" />
                                <TextBox Text="{Binding Configuration.Mes.PackNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Mes.Tooling}">
                                <TextBlock Style="{StaticResource Label}" Text="治具" />
                                <TextBox Text="{Binding Configuration.Mes.Tooling, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Mes.ProdNo}">
                                <TextBlock Style="{StaticResource Label}" Text="工单" />
                                <TextBox Text="{Binding Configuration.Mes.ProdNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,14,0,0"
                        Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Mes.EnableYieldControlUploadToMes|Mes.YieldControlThreshold}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="良率控制" />
                        <UniformGrid Columns="3">
                            <CheckBox x:Name="YieldControlCheckBox"
                                      Content="启用良率控制上传"
                                      IsChecked="{Binding Configuration.Mes.EnableYieldControlUploadToMes}"
                                      Margin="0,4,14,12"
                                      Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Mes.EnableYieldControlUploadToMes}" />
                            <StackPanel Margin="0,0,14,12" IsEnabled="{Binding IsChecked, ElementName=YieldControlCheckBox}" Visibility="{Binding Configuration.Compatibility.VisibleConfigurationFields, Converter={StaticResource FieldVisibility}, ConverterParameter=Mes.YieldControlThreshold}">
                                <TextBlock Style="{StaticResource Label}" Text="上传阈值(%)" />
                                <TextBox Text="{Binding Configuration.Mes.YieldControlThreshold, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
